@page "/kontur-scheduler"
@attribute [Authorize]
@inject AuthenticationStateProvider AuthStateProvider
@inject KonturScheduleStore Store
@inject IToastService Toasts

<PageTitle>Планировщик Контур — SnabDrive</PageTitle>

<div class="page">
    <div class="page__header">
        <div>
            <h1>Планировщик Контур</h1>
            <p class="page__hint">
                Автоматически запускает KonturExport и импортирует выгрузку в «Избранное Контур»
                по расписанию (например, утром и вечером).
            </p>
        </div>
    </div>

    @if (!_canUse)
    {
        <div class="alert alert--warn">Доступ к планировщику не выдан. Обратитесь к администратору.</div>
    }
    else
    {
        <div class="card">
            <h2>Расписание</h2>
            <label class="checkbox-label" style="display:flex;gap:8px;align-items:center;margin-bottom:12px">
                <input type="checkbox" @bind="_enabled" /> Планировщик включён
            </label>

            <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:12px">
                @foreach (var t in _times)
                {
                    <span class="badge badge--info">@t
                        <button class="chip-remove" @onclick="() => RemoveTime(t)" title="Убрать">×</button>
                    </span>
                }
            </div>

            <div class="toolbar">
                <input type="text" class="input" placeholder="ЧЧ:ММ" value="@_newTime" @onchange="OnNewTimeChanged" style="width:140px" />
                <button class="btn" @onclick="AddTime">＋ Добавить время</button>
                <div class="toolbar__spacer"></div>
                <button class="btn btn--primary" @onclick="SaveSchedule">Сохранить</button>
            </div>

            <h2 class="h5" style="margin:20px 0 8px">Контур ловушка (--templates)</h2>
            <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:12px">
                @foreach (var t in _templatesTimes)
                {
                    <span class="badge badge--info">@t
                        <button class="chip-remove" @onclick="() => RemoveTemplateTime(t)" title="Убрать">×</button>
                    </span>
                }
            </div>
            <div class="toolbar">
                <input type="text" class="input" placeholder="ЧЧ:ММ" value="@_newTemplateTime" @onchange="OnNewTemplateTimeChanged" style="width:140px" />
                <button class="btn" @onclick="AddTemplateTime">＋ Добавить время</button>
            </div>
        </div>
    }
</div>

@code {
    private bool _canUse;
    private bool _enabled = true;
    private List<string> _times = new();
    private string _newTime = "08:00";
    private List<string> _templatesTimes = new();
    private string _newTemplateTime = "09:00";

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        _canUse = SnabDrive.Web.Data.SchedulerClaim.CanUse(state.User);

        _enabled = Store.Value.Enabled;
        _times = Store.Value.Times.ToList();
        _templatesTimes = Store.Value.TemplatesTimes.ToList();
    }

    private void OnNewTimeChanged(ChangeEventArgs e) => _newTime = e.Value?.ToString() ?? string.Empty;

    private void AddTime()
    {
        if (TimeSpan.TryParse(_newTime, out var ts))
        {
            var value = ts.ToString(@"hh\:mm");
            if (!_times.Contains(value))
            {
                _times.Add(value);
                _times = _times.OrderBy(x => x).ToList();
            }
        }
    }

    private void RemoveTime(string t) => _times.Remove(t);

    private void OnNewTemplateTimeChanged(ChangeEventArgs e) => _newTemplateTime = e.Value?.ToString() ?? string.Empty;

    private void AddTemplateTime()
    {
        if (TimeSpan.TryParse(_newTemplateTime, out var ts))
        {
            var value = ts.ToString(@"hh\:mm");
            if (!_templatesTimes.Contains(value))
            {
                _templatesTimes.Add(value);
                _templatesTimes = _templatesTimes.OrderBy(x => x).ToList();
            }
        }
    }

    private void RemoveTemplateTime(string t) => _templatesTimes.Remove(t);

    private void SaveSchedule()
    {
        Store.Value.Enabled = _enabled;
        Store.Value.Times = _times.ToList();
        Store.Value.TemplatesTimes = _templatesTimes.ToList();
        Store.Save();
        Toasts.Show("Расписание сохранено", ToastKind.Success);
    }
}
