@page "/workflow"
@using System.Globalization
@using System.Linq
@using System.Security.Claims
@using SnabDrive.Web.Domain
@using SnabDrive.Web.Services
@attribute [Authorize]
@inject IWorkflowService WorkflowSvc
@inject IRolePermissionService RolePerms
@inject IDictionaryService DictSvc
@inject IBranchService BranchSvc
@inject AuthenticationStateProvider AuthStateProvider

<h1 class="page-title">Задачи по закупкам</h1>
<p class="page-subtitle">Воркфлоу по стадиям. Поля редактируются, кнопка переводит закупку на следующую стадию.</p>

@if (_error is not null)
{
    <div class="alert alert-error">@_error</div>
}

@if (_isTenderHead && (_biddingTomorrow > 0 || _biddingToday > 0))
{
    <div class="alert alert-info" style="border-left:4px solid #d97706;background:#fffbeb;color:#92400e;margin:12px 0">
        🔔 <strong>Предстоящие торги:</strong>
        @if (_biddingTomorrow > 0)
        {
            <span>завтра — @_biddingTomorrow</span>
        }
        @if (_biddingTomorrow > 0 && _biddingToday > 0)
        {
            <span>;&nbsp;</span>
        }
        @if (_biddingToday > 0)
        {
            <span>сегодня — @_biddingToday</span>
        }
    </div>
}

<div class="toolbar" style="flex-wrap:wrap;gap:6px;margin:12px 0">
    @foreach (var st in WorkflowStages.All.Where(s => _allowedStages.Contains(s.Id)))
    {
        <button class="@TabClass(st.Id)" @onclick="() => SetStage(st.Id)">@st.Name (@Count(st.Id))</button>
    }
    <div class="toolbar-spacer"></div>
    <div style="display:flex;align-items:center;gap:6px">
        <input class="input" style="min-width:280px" placeholder="🔍 Поиск по всем полям стадии…"
               @bind="_search" @bind:event="oninput" />
        @if (!string.IsNullOrEmpty(_search))
        {
            <button class="btn" title="Очистить поиск" @onclick="ClearSearch">×</button>
        }
    </div>
    <button class="btn" disabled="@_busy" @onclick="LoadAsync">Обновить</button>
</div>

@if (!_loading && _allowedStages.Contains(_stage))
{
    <div class="alert alert-info" style="margin:0 0 12px;font-size:16px;display:flex;align-items:center;gap:8px">
        <span style="font-size:18px">📂</span>
        <span>Открытая стадия: <strong>@WorkflowStages.Name(_stage)</strong></span>
    </div>
}

@if (!_loading && _allowedStages.Count == 0)
{
    <div class="alert alert-info">Вашей роли не назначено ни одной стадии воркфлоу. Настройка: «Роли» → «Стадии воркфлоу».</div>
}

@if (_loading)
{
    <p class="muted">Загрузка…</p>
}
else if (!Rows().Any())
{
    <p class="muted">@(string.IsNullOrWhiteSpace(_search) ? "Нет закупок на этой стадии." : "Ничего не найдено по этому поиску.")</p>
}
else
{
    @foreach (var r in Rows())
    {
        <div class="card" style="margin-bottom:12px">
            <div class="card-body">
                @if (!string.IsNullOrWhiteSpace(r.EisLink))
                {
                    <a href="@r.EisLink" target="_blank" rel="noopener noreferrer" title="@r.EisLink"
                       style="display:inline-flex;align-items:center;gap:4px;margin-bottom:8px;font-size:14px;text-decoration:none">
                        <span style="font-size:18px;line-height:1">🔗</span> ЕИС
                    </a>
                }
                @if (!string.IsNullOrWhiteSpace(r.PurchaseNumber))
                {
                    @if (!string.IsNullOrWhiteSpace(r.EisLink))
                    {
                        <a href="@r.EisLink" target="_blank" rel="noopener noreferrer" title="Номер закупки: @r.PurchaseNumber"
                           style="display:inline-flex;align-items:center;gap:4px;margin:0 0 8px 16px;font-size:14px;text-decoration:none">
                            <span style="font-size:16px;line-height:1">№</span> @r.PurchaseNumber
                        </a>
                    }
                    else
                    {
                        <span style="display:inline-flex;align-items:center;gap:4px;margin:0 0 8px 16px;font-size:14px;color:#374151">
                            <span style="font-size:16px;line-height:1">№</span> @r.PurchaseNumber
                        </span>
                    }
                }

                @* ===== Вложения и ссылки — вверху на всех этапах ===== *@
                <div style="margin-bottom:10px">
                    <label class="form-label">Вложения</label>
                    <div>
                        @foreach (var a in SplitAttachments(_edits[r.Id].Attachments))
                        {
                            <span style="display:inline-flex;align-items:center;gap:4px;margin:0 8px 4px 0">
                                <a href="@a" target="_blank" rel="noopener">@System.IO.Path.GetFileName(a)</a>
                                <button class="btn btn-link btn--danger" style="padding:0 4px;line-height:1" @onclick="() => DeleteAttachment(r.Id, a)" title="Удалить">×</button>
                            </span>
                        }
                    </div>
                    <InputFile OnChange="ev => OnFileAsync(ev, r.Id)" class="form-control" style="max-width:360px;margin-top:4px" />
                </div>

                @* ===== Этапы 1 / 1.2 / 2 (Согласование): полный набор редактируемых полей ===== *@
                @if (_stage == 1 || _stage == 2 || _stage == 12)
                {
                    <div class="wf-grid">
                        <div class="wf-field">
                            <label class="wf-label">Наименование</label>
                            <textarea class="wf-area" @bind="_edits[r.Id].NameLink" @bind:after="() => SaveAsync(r.Id)"></textarea>
                        </div>
                        <div class="wf-field">
                            <label class="wf-label">Заказчик</label>
                            <textarea class="wf-area" @bind="_edits[r.Id].Customer" @bind:after="() => SaveAsync(r.Id)"></textarea>
                        </div>
                        <div class="wf-field">
                            <label class="wf-label">Тип закупки</label>
                            <select class="wf-input" @bind="_edits[r.Id].TypeOfPurchaseId" @bind:after="() => SaveAsync(r.Id)">
                                <option value="">— не выбран —</option>
                                @foreach (var t in _types)
                                {
                                    <option value="@t.Id">@t.Name</option>
                                }
                            </select>
                        </div>
                        <div class="wf-field">
                            <label class="wf-label">Место поставки</label>
                            <textarea class="wf-area" @bind="_edits[r.Id].PlaceOfDelivery" @bind:after="() => SaveAsync(r.Id)"></textarea>
                        </div>
                        <div class="wf-field">
                            <label class="wf-label">Номер резерва</label>
                            <input class="wf-input" @bind="_edits[r.Id].ReserveNumber" @bind:after="() => SaveAsync(r.Id)" />
                        </div>
                        <div class="wf-field">
                            <label class="wf-label">Статус резерва B2B</label>
                            <select class="wf-input" @bind="_edits[r.Id].B2BStatusId" @bind:after="() => SaveAsync(r.Id)">
                                <option value="">— не выбран —</option>
                                @foreach (var b in _b2b)
                                {
                                    <option value="@b.Id">@b.Name</option>
                                }
                            </select>
                        </div>
                        <div class="wf-field">
                            <label class="wf-label">Нац режим</label>
                            <input class="wf-input" @bind="_edits[r.Id].NationalMode" @bind:after="() => SaveAsync(r.Id)" />
                        </div>
                        <div class="wf-field">
                            <label class="wf-label">Дата торгов</label>
                            <input type="datetime-local" class="wf-input" @bind="_edits[r.Id].BiddingDate" @bind:format="yyyy-MM-dd'T'HH:mm" @bind:after="() => SaveAsync(r.Id)" />
                        </div>
                        <div class="wf-field">
                            <label class="wf-label">НМЦК</label>
                            <input type="number" class="wf-input" @bind="_edits[r.Id].NMCK" @bind:after="() => SaveAsync(r.Id)" />
                        </div>
                        <div class="wf-field">
                            <label class="wf-label">Наша минимальная сумма</label>
                            <input type="number" class="wf-input" @bind="_edits[r.Id].MinPrice" @bind:after="() => SaveAsync(r.Id)" />
                        </div>
                        <div class="wf-field">
                            <label class="wf-label">Дата доставки</label>
                            <input type="date" class="wf-input" @bind="_edits[r.Id].DeliveryDate" @bind:format="yyyy-MM-dd" @bind:after="() => SaveAsync(r.Id)" />
                        </div>
                        <div class="wf-field">
                            <label class="wf-label">Примечания</label>
                            <textarea class="wf-area" @bind="_edits[r.Id].Note" @bind:after="() => SaveAsync(r.Id)"></textarea>
                        </div>
                        @if (_stage == 12)
                        {
                            <div class="wf-field">
                                <label class="wf-label">Звони</label>
                                <label style="display:flex;align-items:center;gap:8px;font-size:15px;font-weight:600">
                                    <input type="checkbox" style="width:20px;height:20px" checked="@_edits[r.Id].IsCall" @onchange="ev => OnToggleCall(r.Id, ev)" />
                                    <span>📞 Звони</span>
                                </label>
                            </div>
                        }
                        @if (_stage == 1)
                        {
                            <div class="wf-field">
                                <label class="wf-label">По заявкам</label>
                                <label style="display:flex;align-items:center;gap:8px;font-size:15px;font-weight:600">
                                    <input type="checkbox" style="width:20px;height:20px" checked="@_edits[r.Id].IsByRequest" @onchange="ev => OnToggleByRequest(r.Id, ev)" />
                                    <span>📋 По заявкам</span>
                                </label>
                            </div>
                        }
                    </div>
                }
                @* ===== Этап 3 «Подача заявки на площадку»: те же поля, только чтение ===== *@
                else if (_stage == 3)
                {
                    <div class="wf-grid">
                        <div class="wf-field"><label class="wf-label">Заказчик</label><div class="wf-readonly">@r.Customer</div></div>
                        <div class="wf-field"><label class="wf-label">НМЦК</label><div class="wf-readonly">@r.NMCK.ToString("N2")</div></div>
                        <div class="wf-field"><label class="wf-label">Дата торгов</label><div class="wf-readonly">@Fmt(r.BiddingDate)</div></div>
                        <div class="wf-field"><label class="wf-label">Тип закупки</label><div class="wf-readonly">@r.TypeOfPurchaseName</div></div>
                        <div class="wf-field"><label class="wf-label">Наша минимальная сумма</label><div class="wf-readonly">@r.MinPrice.ToString("N2")</div></div>
                        <div class="wf-field"><label class="wf-label">Место поставки</label><div class="wf-readonly">@r.PlaceOfDelivery</div></div>
                    </div>
                }
                @* ===== Этап 4 «Торги»: наименование/заказчик/тип — чтение, дата торгов — редактируется;
                      при флажке «Звони» подсвечивается наша минимальная сумма ===== *@
                else if (_stage == 4)
                {
                    <div class="wf-grid">
                        <div class="wf-field"><label class="wf-label">Наименование</label><div class="wf-readonly">@r.NameLink</div></div>
                        <div class="wf-field"><label class="wf-label">Заказчик</label><div class="wf-readonly">@r.Customer</div></div>
                        <div class="wf-field"><label class="wf-label">Тип закупки</label><div class="wf-readonly">@r.TypeOfPurchaseName</div></div>
                        <div class="wf-field"><label class="wf-label">НМЦК</label><div class="wf-readonly">@r.NMCK.ToString("N2")</div></div>
                        <div class="wf-field">
                            <label class="wf-label">Дата и время торгов</label>
                            <input type="datetime-local" class="wf-input" @bind="_edits[r.Id].BiddingDate" @bind:format="yyyy-MM-dd'T'HH:mm" @bind:after="() => SaveAsync(r.Id)" />
                        </div>
                        <div class="wf-field">
                            <label class="wf-label">Наша минимальная сумма</label>
                            @if (_isDirector)
                            {
                                <input type="number" class="wf-input" style="@Highlight(r.IsCall)"
                                       @bind="_edits[r.Id].MinPrice" @bind:after="() => SaveAsync(r.Id)" />
                                <label style="display:flex;align-items:center;gap:8px;margin-top:4px;font-size:15px;font-weight:600">
                                    <input type="checkbox" style="width:20px;height:20px" checked="@_edits[r.Id].IsCall" @onchange="ev => OnToggleCall(r.Id, ev)" />
                                    <span>📞 Звони</span>
                                </label>
                            }
                            else if (r.IsCall)
                            {
                                <div class="wf-readonly" style="border:2px solid #d97706;background:#fff7ed;color:#92400e;font-weight:800;font-size:17px">@r.MinPrice.ToString("N2")</div>
                                <span style="display:inline-flex;align-items:center;gap:6px;margin-top:4px;font-size:15px;font-weight:800;color:#b45309">📞 Звони</span>
                            }
                            else
                            {
                                <div class="wf-readonly">@r.MinPrice.ToString("N2")</div>
                            }
                        </div>
                        <div class="wf-field">
                            <label class="wf-label">Итог цена</label>
                            <input type="number" class="wf-input" @bind="_edits[r.Id].ResultPrice" @bind:after="() => SaveAsync(r.Id)" />
                        </div>
                        <div class="wf-field">
                            <label class="wf-label">Место на торгах</label>
                            <input class="wf-input" @bind="_edits[r.Id].Place" @bind:after="() => SaveAsync(r.Id)" />
                        </div>
                    </div>
                }
                @* ===== Этап 5 «Перемещение товара» ===== *@
                else if (_stage == 5)
                {
                    <div class="wf-grid">
                        <div class="wf-field">
                            <label class="wf-label">Заказчик</label>
                            <textarea class="wf-area" @bind="_edits[r.Id].Customer" @bind:after="() => SaveAsync(r.Id)"></textarea>
                        </div>
                        <div class="wf-field">
                            <label class="wf-label">Тип закупки</label>
                            <select class="wf-input" @bind="_edits[r.Id].TypeOfPurchaseId" @bind:after="() => SaveAsync(r.Id)">
                                <option value="">— не выбран —</option>
                                @foreach (var t in _types)
                                {
                                    <option value="@t.Id">@t.Name</option>
                                }
                            </select>
                        </div>
                        <div class="wf-field">
                            <label class="wf-label">Место поставки</label>
                            <textarea class="wf-area" @bind="_edits[r.Id].PlaceOfDelivery" @bind:after="() => SaveAsync(r.Id)"></textarea>
                        </div>
                        <div class="wf-field">
                            <label class="wf-label">Статус резерва B2B</label>
                            <select class="wf-input" @bind="_edits[r.Id].B2BStatusId" @bind:after="() => SaveAsync(r.Id)">
                                <option value="">— не выбран —</option>
                                @foreach (var b in _b2b)
                                {
                                    <option value="@b.Id">@b.Name</option>
                                }
                            </select>
                        </div>
                        <div class="wf-field">
                            <label class="wf-label">Нац режим</label>
                            <input class="wf-input" @bind="_edits[r.Id].NationalMode" @bind:after="() => SaveAsync(r.Id)" />
                        </div>
                        <div class="wf-field">
                            <label class="wf-label">Ожидаемая дата доставки</label>
                            <input type="date" class="wf-input" @bind="_edits[r.Id].ExpectedDeliveryDate" @bind:format="yyyy-MM-dd" @bind:after="() => SaveAsync(r.Id)" />
                        </div>
                        <div class="wf-field">
                            <label class="wf-label">Примечания</label>
                            <textarea class="wf-area" @bind="_edits[r.Id].Note" @bind:after="() => SaveAsync(r.Id)"></textarea>
                        </div>
                    </div>
                }
                @* ===== Этап 6 «Контракт»: минимум полей + статус контракта и отметка «Проверен» ===== *@
                else if (_stage == 6)
                {
                    <div class="wf-grid">
                        <div class="wf-field">
                            <label class="wf-label">Наименование</label>
                            <textarea class="wf-area" @bind="_edits[r.Id].NameLink" @bind:after="() => SaveAsync(r.Id)"></textarea>
                        </div>
                        <div class="wf-field">
                            <label class="wf-label">Заказчик</label>
                            <textarea class="wf-area" @bind="_edits[r.Id].Customer" @bind:after="() => SaveAsync(r.Id)"></textarea>
                        </div>
                        <div class="wf-field">
                            <label class="wf-label">Итог сумма</label>
                            <input type="number" class="wf-input" @bind="_edits[r.Id].ResultPrice" @bind:after="() => SaveAsync(r.Id)" />
                        </div>
                        <div class="wf-field">
                            <label class="wf-label">Место поставки</label>
                            <textarea class="wf-area" @bind="_edits[r.Id].PlaceOfDelivery" @bind:after="() => SaveAsync(r.Id)"></textarea>
                        </div>
                        <div class="wf-field">
                            <label class="wf-label">Статус контракта</label>
                            <select class="wf-input" @bind="_edits[r.Id].ContractStatusId" @bind:after="() => SaveAsync(r.Id)">
                                <option value="">— не выбран —</option>
                                @foreach (var cs in ContractStatuses.All)
                                {
                                    <option value="@cs.Id">@cs.Name</option>
                                }
                            </select>
                        </div>
                        <div class="wf-field">
                            <label class="wf-label">Проверен</label>
                            <label style="display:flex;align-items:center;gap:8px;font-size:15px;font-weight:600">
                                <input type="checkbox" style="width:20px;height:20px" checked="@_edits[r.Id].IsContractChecked" @onchange="ev => OnToggleContractChecked(r.Id, ev)" />
                                <span>✅ Проверен</span>
                            </label>
                        </div>
                    </div>
                }
                @* ===== Этап 7 «Логистические документы»: дата доставки, файл, филиал, оповещение ===== *@
                else if (_stage == 7)
                {
                    <div class="wf-grid">
                        <div class="wf-field">
                            <label class="wf-label">Ожидаемая дата доставки</label>
                            <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
                                <input type="date" class="wf-input" @bind="_edits[r.Id].ExpectedDeliveryDate" @bind:format="yyyy-MM-dd" @bind:after="() => SaveAsync(r.Id)" />
                                <label style="display:flex;align-items:center;gap:8px;font-size:15px;font-weight:600">
                                    <input type="checkbox" style="width:20px;height:20px" checked="@_edits[r.Id].IsEisFilled" @onchange="ev => OnToggleEisFilled(r.Id, ev)" />
                                    <span>🧾 Заполнить в ЕИС</span>
                                </label>
                            </div>
                        </div>
                        <div class="wf-field">
                            <label class="wf-label">Филиал</label>
                            <select class="wf-input" @bind="_edits[r.Id].BranchId" @bind:after="() => SaveAsync(r.Id)">
                                <option value="">— не выбран —</option>
                                @foreach (var br in _branches)
                                {
                                    <option value="@br.Id">@br.Name</option>
                                }
                            </select>
                        </div>
                        <div class="wf-field">
                            <label class="wf-label">Файл для оповещения</label>
                            @if (!string.IsNullOrWhiteSpace(r.BranchFilePath))
                            {
                                <div style="margin-bottom:4px">
                                    <a href="@r.BranchFilePath" target="_blank" rel="noopener">@System.IO.Path.GetFileName(r.BranchFilePath)</a>
                                </div>
                            }
                            <InputFile OnChange="ev => OnBranchFileAsync(ev, r.Id)" class="form-control" />
                        </div>
                    </div>
                    <div style="margin-top:10px;display:flex;flex-wrap:wrap;gap:8px;align-items:center">
                        <button class="btn btn-primary" disabled="@(_edits[r.Id].BranchId is null)" @onclick="() => NotifyBranch(r.Id)">
                            📨 Оповестить филиал и перейти далее
                        </button>
                        <button class="btn" @onclick="() => Advance(r.Id, 9)">→ Ожидание доставки (без оповещения)</button>
                        @if (_edits[r.Id].BranchId is null)
                        {
                            <span class="muted" style="font-size:12px">Выберите филиал, чтобы отправить оповещение</span>
                        }
                    </div>
                }
                @* ===== Этап 8 «Ожидание доставки»: дата доставки подсвечивается при отметке «Заполнить в ЕИС» ===== *@
                else if (_stage == 8)
                {
                    <div class="wf-grid">
                        <div class="wf-field">
                            <label class="wf-label">Наименование</label>
                            <textarea class="wf-area" @bind="_edits[r.Id].NameLink" @bind:after="() => SaveAsync(r.Id)"></textarea>
                        </div>
                        <div class="wf-field">
                            <label class="wf-label">Заказчик</label>
                            <textarea class="wf-area" @bind="_edits[r.Id].Customer" @bind:after="() => SaveAsync(r.Id)"></textarea>
                        </div>
                        <div class="wf-field">
                            <label class="wf-label">Ожидаемая дата доставки</label>
                            <input type="date" class="wf-input" style="@Highlight(r.IsEisFilled)"
                                   @bind="_edits[r.Id].ExpectedDeliveryDate" @bind:format="yyyy-MM-dd" @bind:after="() => SaveAsync(r.Id)" />
                            @if (r.IsEisFilled)
                            {
                                <span style="display:inline-flex;align-items:center;gap:6px;margin-top:4px;font-size:15px;font-weight:800;color:#b45309">🧾 Заполнить в ЕИС</span>
                            }
                        </div>
                        <div class="wf-field">
                            <label class="wf-label">Место поставки</label>
                            <textarea class="wf-area" @bind="_edits[r.Id].PlaceOfDelivery" @bind:after="() => SaveAsync(r.Id)"></textarea>
                        </div>
                        <div class="wf-field">
                            <label class="wf-label">Примечание</label>
                            <textarea class="wf-area" @bind="_edits[r.Id].Note" @bind:after="() => SaveAsync(r.Id)"></textarea>
                        </div>
                    </div>
                }
                @* ===== Остальные этапы (9, 10, «Проблемы с приемкой»): прежняя форма ===== *@
                else
                {
                    <div class="wf-grid">
                        <div class="wf-field"><label class="wf-label">Наименование</label><textarea class="wf-area" @bind="_edits[r.Id].NameLink" @bind:after="() => SaveAsync(r.Id)"></textarea></div>
                        <div class="wf-field"><label class="wf-label">Заказчик</label><textarea class="wf-area" @bind="_edits[r.Id].Customer" @bind:after="() => SaveAsync(r.Id)"></textarea></div>
                        <div class="wf-field"><label class="wf-label">НМЦК</label><input type="number" class="wf-input" @bind="_edits[r.Id].NMCK" @bind:after="() => SaveAsync(r.Id)" /></div>
                        <div class="wf-field"><label class="wf-label">Дата торгов</label><input class="wf-input" value="@Fmt(r.BiddingDate)" disabled /></div>
                        <div class="wf-field"><label class="wf-label">Резерв 1С</label><input class="wf-input" @bind="_edits[r.Id].ReserveNumber" @bind:after="() => SaveAsync(r.Id)" /></div>
                        <div class="wf-field"><label class="wf-label">Место на торгах</label><input class="wf-input" @bind="_edits[r.Id].Place" @bind:after="() => SaveAsync(r.Id)" /></div>
                        <div class="wf-field"><label class="wf-label">Место поставки</label><textarea class="wf-area" @bind="_edits[r.Id].PlaceOfDelivery" @bind:after="() => SaveAsync(r.Id)"></textarea></div>
                        <div class="wf-field"><label class="wf-label">Итог. цена</label><input type="number" class="wf-input" @bind="_edits[r.Id].ResultPrice" @bind:after="() => SaveAsync(r.Id)" /></div>
                        <div class="wf-field"><label class="wf-label">Примечание</label><textarea class="wf-area" @bind="_edits[r.Id].Note" @bind:after="() => SaveAsync(r.Id)"></textarea></div>
                    </div>
                }

                @if (_stage == 13 && !string.IsNullOrWhiteSpace(r.ReturnReason))
                {
                    <div class="alert alert-error" style="margin-top:10px">⚠ Проблема с приемкой: @r.ReturnReason</div>
                }

                <div class="toolbar" style="margin-top:10px;flex-wrap:wrap;gap:6px;align-items:center">
                    <span class="muted" style="font-size:12px">Изменения сохраняются автоматически</span>
                    @if (_stage == 1)
                    {
                        <button class="btn" @onclick="() => Advance(r.Id, 2)">→ 1.2 Резерв</button>
                        <button class="btn" @onclick="() => Advance(r.Id, 14)">→ 2 Согласование</button>
                    }
                    else if (_stage == 2)
                    {
                        <button class="btn" @onclick="() => Advance(r.Id, 3)">→ 2 Согласование</button>
                    }
                    else if (_stage == 12)
                    {
                        <button class="btn" @onclick="() => Advance(r.Id, 13)">Согласовано → 3 Подача</button>
                    }
                    else if (_stage == 3)
                    {
                        <button class="btn" @onclick="() => Advance(r.Id, 4)">Размещена → 4 Торги</button>
                    }
                    else if (_stage == 4)
                    {
                        <button class="btn" @onclick="() => Advance(r.Id, 5)">Выиграл →</button>
                        <button class="btn btn--danger" @onclick="() => Advance(r.Id, 6)">Проиграл</button>
                    }
                    else if (_stage == 5)
                    {
                        <button class="btn" @onclick="() => Advance(r.Id, 7)">→ 6 Контракт</button>
                    }
                    else if (_stage == 6)
                    {
                        <button class="btn" @onclick="() => Advance(r.Id, 8)">→ Логистика</button>
                    }
                    @* Этап 7 переводится далее кнопкой «Оповестить филиал» (в блоке полей). *@
                    else if (_stage == 8)
                    {
                        <button class="btn" @onclick="() => Advance(r.Id, 10)">→ Приемка</button>
                    }
                    else if (_stage == 9)
                    {
                        <button class="btn" @onclick="() => Advance(r.Id, 11)">→ Оплата</button>
                        <button class="btn btn--danger" @onclick="() => OpenReturn(r.Id)">⚠ Проблема с приемкой</button>
                    }
                    else if (_stage == 10)
                    {
                        <button class="btn" @onclick="() => Advance(r.Id, 12)">Завершить</button>
                    }
                </div>
            </div>
        </div>
    }
}

@* ===== Модальное окно «Проблема с приемкой» (этап 9) ===== *@
@if (_returnFor is not null)
{
    <div style="position:fixed;inset:0;background:rgba(0,0,0,.45);display:flex;align-items:center;justify-content:center;z-index:1000" @onclick="CloseReturn">
        <div style="background:#fff;border-radius:8px;max-width:480px;width:92%;box-shadow:0 10px 40px rgba(0,0,0,.3)" @onclick:stopPropagation="true">
            <div style="padding:16px 20px;border-bottom:1px solid #eee;font-size:18px;font-weight:800">Проблема с приемкой</div>
            <div style="padding:16px 20px">
                <label class="wf-label" style="display:block;margin-bottom:6px">Описание проблемы</label>
                <textarea class="wf-area" style="min-height:90px" @bind="_returnReason"></textarea>
            </div>
            <div style="padding:12px 20px;border-top:1px solid #eee;display:flex;justify-content:flex-end;gap:8px">
                <button class="btn" @onclick="CloseReturn">Отмена</button>
                <button class="btn btn--danger" @onclick="SubmitReturn">Сохранить</button>
            </div>
        </div>
    </div>
}

@code {
    private List<WorkflowRow> _rows = new();
    private readonly Dictionary<int, WorkflowEdit> _edits = new();
    private IReadOnlyList<DictionaryItemDto> _types = Array.Empty<DictionaryItemDto>();
    private IReadOnlyList<DictionaryItemDto> _b2b = Array.Empty<DictionaryItemDto>();
    private IReadOnlyList<BranchDto> _branches = Array.Empty<BranchDto>();
    private int? _returnFor;                 // Id закупки, для которой открыто окно «Проблема с приемкой»
    private string _returnReason = string.Empty;
    private bool _busy;
    private bool _loading = true;
    private int _stage = 1;
    private string? _error;
    private ChangeActor _actor = new("user", "Пользователь");
    private HashSet<int> _allowedStages = new();
    private bool _isTenderHead;
    private bool _isDirector;              // Директор правит мин. сумму и «Звони» на этапе 4
    private string _search = string.Empty;  // общий поиск по всем полям текущей стадии
    private int _biddingTomorrow;
    private int _biddingToday;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            var name = state.User.Identity?.Name ?? "Пользователь";
            _actor = new ChangeActor(name, name);

            // Стадии, разрешённые пользователю по его ролям (настройка в /roles → «Стадии воркфлоу»).
            var uid = state.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
            var stages = await RolePerms.GetEffectiveStagesAsync(uid);
            _allowedStages = stages.ToHashSet();

            // Словари для выпадающих списков «Тип закупки» и «Статус резерва B2B».
            _types = await DictSvc.GetTypesOfPurchaseAsync();
            _b2b = await DictSvc.GetB2BStatusesAsync();
            _branches = await BranchSvc.GetActiveAsync();

            // Всплывающее уведомление о предстоящих торгах — для роли «Руководитель тендерного отдела».
            _isTenderHead = state.User.IsInRole("TenderHead");
            _isDirector = state.User.IsInRole(AppRoles.Director);
            if (_isTenderHead)
            {
                (_biddingTomorrow, _biddingToday) = await WorkflowSvc.GetUpcomingBiddingCountsAsync();
            }

            // Стадия по умолчанию — первая из разрешённых.
            var firstAllowed = WorkflowStages.All.FirstOrDefault(s => _allowedStages.Contains(s.Id));
            if (_allowedStages.Contains(firstAllowed.Id))
            {
                _stage = firstAllowed.Id;
            }

            await LoadAsync();
        }
        catch
        {
            // При пререндере (F5) контекст авторизации/БД может быть недоступен и запрос
            // завершился бы 500. Интерактивная цепь выполнит инициализацию повторно и
            // отрисует страницу, поэтому здесь исключение достаточно проглотить.
        }
    }

    private async Task LoadAsync()
    {
        _busy = true;
        try
        {
            _rows = (await WorkflowSvc.GetAsync()).ToList();
            _edits.Clear();
            foreach (var r in _rows)
            {
                _edits[r.Id] = new WorkflowEdit
                {
                    NameLink = r.NameLink,
                    Customer = r.Customer,
                    NMCK = r.NMCK,
                    ReserveNumber = r.ReserveNumber,
                    Place = r.Place ?? string.Empty,
                    PlaceOfDelivery = r.PlaceOfDelivery,
                    ResultPrice = r.ResultPrice,
                    Note = r.Note,
                    Attachments = r.Attachments ?? string.Empty,
                    TypeOfPurchaseId = r.TypeOfPurchaseId,
                    B2BStatusId = r.B2BStatusId,
                    NationalMode = r.NationalMode,
                    BiddingDate = r.BiddingDate,
                    MinPrice = r.MinPrice,
                    DeliveryDate = r.DeliveryDate,
                    IsCall = r.IsCall,
                    IsByRequest = r.IsByRequest,
                    ExpectedDeliveryDate = r.ExpectedDeliveryDate,
                    BranchId = r.BranchId,
                    ContractStatusId = r.ContractStatusId,
                    IsContractChecked = r.IsContractChecked,
                    IsEisFilled = r.IsEisFilled
                };
            }
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; _loading = false; }
    }

    private void ClearSearch() => _search = string.Empty;

    private void SetStage(int stage) => _stage = stage;

    private string TabClass(int stage) => _stage == stage ? "btn btn-primary" : "btn";

    private int Count(int stage) => _rows.Count(r => r.Stage == stage && MatchesSearch(r));

    private List<WorkflowRow> Rows() => _rows.Where(r => r.Stage == _stage && MatchesSearch(r)).ToList();

    // Общий поиск по всем полям строки стадии: текст, суммы, даты, справочники, стадия.
    private bool MatchesSearch(WorkflowRow r)
    {
        var term = _search?.Trim();
        if (string.IsNullOrEmpty(term))
        {
            return true;
        }

        if (decimal.TryParse(term, NumberStyles.Number, CultureInfo.InvariantCulture, out var amount) &&
            (r.NMCK == amount || r.MinPrice == amount || r.ResultPrice == amount))
        {
            return true;
        }

        if (RegistryService.TryParseDate(term, out var date) &&
            (r.BiddingDate?.Date == date.Date || r.ExpectedDeliveryDate?.Date == date.Date || r.DeliveryDate?.Date == date.Date))
        {
            return true;
        }

        return Has(r.NameLink, term) || Has(r.EisLink, term) || Has(r.Customer, term) ||
               Has(r.PurchaseNumber, term) || Has(r.ReserveNumber, term) || Has(r.Place, term) ||
               Has(r.PlaceOfDelivery, term) || Has(r.NationalMode, term) || Has(r.Note, term) ||
               Has(r.Attachments, term) || Has(r.ReturnReason, term) ||
               Has(r.TypeOfPurchaseName, term) || Has(r.B2BStatusName, term) ||
               Has(WorkflowStages.Name(r.Stage), term) || Has(ContractStatuses.Name(r.ContractStatusId), term) ||
               Has(Fmt(r.BiddingDate), term) || Has(Fmt(r.ExpectedDeliveryDate), term) ||
               Has(r.DeliveryDate?.ToString("dd.MM.yyyy"), term) ||
               Has(r.NMCK.ToString("N2", CultureInfo.InvariantCulture), term) ||
               Has(r.MinPrice.ToString("N2", CultureInfo.InvariantCulture), term) ||
               Has(r.ResultPrice.ToString("N2", CultureInfo.InvariantCulture), term) ||
               r.Id.ToString(CultureInfo.InvariantCulture) == term;
    }

    private static bool Has(string? value, string term) =>
        !string.IsNullOrEmpty(value) && value.Contains(term, StringComparison.OrdinalIgnoreCase);

    private static string Fmt(DateTime? d) => d?.ToString("dd.MM.yyyy HH:mm") ?? string.Empty;

    // Подсветка «требуется внимание»: как у флажка «Звони» (этап 4) и «Заполнить в ЕИС» (этап 8).
    private static string Highlight(bool on) =>
        on ? "border:2px solid #d97706;background:#fff7ed;color:#92400e;font-weight:800;font-size:17px" : string.Empty;

    private static string[] SplitAttachments(string value) =>
        string.IsNullOrWhiteSpace(value) ? Array.Empty<string>() : value.Split(';', StringSplitOptions.RemoveEmptyEntries);

    // Автосохранение строки (как в реестре): вызывается при уходе с поля, без полной перезагрузки.
    private async Task SaveAsync(int id)
    {
        _error = null;
        var result = await WorkflowSvc.UpdateAsync(id, _edits[id]);
        if (!result.Success) { _error = result.Error; }
    }

    // Флажок «Звони» (этап Согласование): явное сохранение, чтобы отметка точно попала в БД.
    private async Task OnToggleCall(int id, ChangeEventArgs ev)
    {
        _edits[id].IsCall = ev.Value is bool b && b;
        await SaveAsync(id);
    }

    // Флажок «По заявкам» (этап 1).
    private async Task OnToggleByRequest(int id, ChangeEventArgs ev)
    {
        _edits[id].IsByRequest = ev.Value is bool b && b;
        await SaveAsync(id);
    }

    // Флажок «Проверен» (этап 6 «Контракт»).
    private async Task OnToggleContractChecked(int id, ChangeEventArgs ev)
    {
        _edits[id].IsContractChecked = ev.Value is bool b && b;
        await SaveAsync(id);
    }

    // Флажок «Заполнить в ЕИС» (этап 7) — подсвечивает дату доставки на этапе 8.
    private async Task OnToggleEisFilled(int id, ChangeEventArgs ev)
    {
        _edits[id].IsEisFilled = ev.Value is bool b && b;
        await SaveAsync(id);
    }

    // Этап 7: сохранить отдельный файл для оповещения филиала.
    private async Task OnBranchFileAsync(InputFileChangeEventArgs ev, int id)
    {
        _error = null;
        try
        {
            var file = ev.File;
            await using var stream = file.OpenReadStream(20 * 1024 * 1024);
            var result = await WorkflowSvc.SaveBranchFileAsync(id, file.Name, stream);
            if (!result.Success) { _error = result.Error; }
            await LoadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    // Этап 7: оповестить филиал в Битрикс24 и перевести на следующий этап.
    private async Task NotifyBranch(int id)
    {
        _error = null;
        var result = await WorkflowSvc.NotifyBranchAsync(id, _actor);
        if (!result.Success) { _error = result.Error; return; }
        await LoadAsync();
    }

    // Этап 9: окно «Проблема с приемкой» с описанием.
    private void OpenReturn(int id) { _returnFor = id; _returnReason = string.Empty; }

    private void CloseReturn() { _returnFor = null; _returnReason = string.Empty; }

    private async Task SubmitReturn()
    {
        if (_returnFor is null) { return; }
        _error = null;
        var result = await WorkflowSvc.ReturnAsync(_returnFor.Value, _returnReason, _actor);
        if (!result.Success) { _error = result.Error; return; }
        CloseReturn();
        await LoadAsync();
    }

    private async Task DeleteAttachment(int id, string path)
    {
        _error = null;
        var result = await WorkflowSvc.DeleteAttachmentAsync(id, path);
        if (!result.Success) { _error = result.Error; return; }
        await LoadAsync();
    }

    private async Task Advance(int id, int code)
    {
        _error = null;
        var result = await WorkflowSvc.AdvanceAsync(id, code, _actor);
        if (!result.Success) { _error = result.Error; return; }
        await LoadAsync();
    }

    private async Task OnFileAsync(InputFileChangeEventArgs ev, int id)
    {
        _error = null;
        try
        {
            foreach (var file in ev.GetMultipleFiles(10))
            {
                await using var stream = file.OpenReadStream(20 * 1024 * 1024);
                var result = await WorkflowSvc.SaveAttachmentAsync(id, file.Name, stream);
                if (!result.Success) { _error = result.Error; }
            }
            await LoadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }
}
