@page "/workflow"
@using System.Globalization
@using System.Linq
@using System.Security.Claims
@using SnabDrive.Web.Domain
@using SnabDrive.Web.Services
@attribute [Authorize]
@inject IWorkflowService WorkflowSvc
@inject IRolePermissionService RolePerms
@inject IDictionaryService DictSvc
@inject AuthenticationStateProvider AuthStateProvider

<h1 class="page-title">Задачи по закупкам</h1>
<p class="page-subtitle">Воркфлоу по стадиям. Поля редактируются, кнопка переводит закупку на следующую стадию.</p>

@if (_error is not null)
{
    <div class="alert alert-error">@_error</div>
}

@if (_isTenderHead && (_biddingTomorrow > 0 || _biddingToday > 0))
{
    <div class="alert alert-info" style="border-left:4px solid #d97706;background:#fffbeb;color:#92400e;margin:12px 0">
        🔔 <strong>Предстоящие торги:</strong>
        @if (_biddingTomorrow > 0)
        {
            <span>завтра — @_biddingTomorrow</span>
        }
        @if (_biddingTomorrow > 0 && _biddingToday > 0)
        {
            <span>;&nbsp;</span>
        }
        @if (_biddingToday > 0)
        {
            <span>сегодня — @_biddingToday</span>
        }
    </div>
}

<div class="toolbar" style="flex-wrap:wrap;gap:6px;margin:12px 0">
    @foreach (var st in WorkflowStages.All.Where(s => _allowedStages.Contains(s.Id)))
    {
        <button class="@TabClass(st.Id)" @onclick="() => SetStage(st.Id)">@st.Name (@Count(st.Id))</button>
    }
    <div class="toolbar-spacer"></div>
    <button class="btn" disabled="@_busy" @onclick="LoadAsync">Обновить</button>
</div>

@if (!_loading && _allowedStages.Count == 0)
{
    <div class="alert alert-info">Вашей роли не назначено ни одной стадии воркфлоу. Настройка: «Роли» → «Стадии воркфлоу».</div>
}

@if (_loading)
{
    <p class="muted">Загрузка…</p>
}
else if (!Rows().Any())
{
    <p class="muted">Нет закупок на этой стадии.</p>
}
else
{
    @foreach (var r in Rows())
    {
        <div class="card" style="margin-bottom:12px">
            <div class="card-body">
                @if (!string.IsNullOrWhiteSpace(r.EisLink))
                {
                    <a href="@r.EisLink" target="_blank" rel="noopener noreferrer" title="@r.EisLink"
                       style="display:inline-flex;align-items:center;gap:4px;margin-bottom:8px;font-size:14px;text-decoration:none">
                        <span style="font-size:18px;line-height:1">🔗</span> ЕИС
                    </a>
                }

                @* ===== Вложения и ссылки — вверху на всех этапах ===== *@
                <div style="margin-bottom:10px">
                    <label class="form-label">Вложения</label>
                    <div>
                        @foreach (var a in SplitAttachments(_edits[r.Id].Attachments))
                        {
                            <span style="display:inline-flex;align-items:center;gap:4px;margin:0 8px 4px 0">
                                <a href="@a" target="_blank" rel="noopener">@System.IO.Path.GetFileName(a)</a>
                                <button class="btn btn-link btn--danger" style="padding:0 4px;line-height:1" @onclick="() => DeleteAttachment(r.Id, a)" title="Удалить">×</button>
                            </span>
                        }
                    </div>
                    <InputFile OnChange="ev => OnFileAsync(ev, r.Id)" class="form-control" style="max-width:360px;margin-top:4px" />
                </div>

                @* ===== Этапы 1 / 1.2 / 2 (Согласование): полный набор редактируемых полей ===== *@
                @if (_stage == 1 || _stage == 2 || _stage == 12)
                {
                    <div class="wf-grid">
                        <div class="wf-field">
                            <label class="wf-label">Наименование</label>
                            <textarea class="wf-area" @bind="_edits[r.Id].NameLink" @bind:after="() => SaveAsync(r.Id)"></textarea>
                        </div>
                        <div class="wf-field">
                            <label class="wf-label">Заказчик</label>
                            <textarea class="wf-area" @bind="_edits[r.Id].Customer" @bind:after="() => SaveAsync(r.Id)"></textarea>
                        </div>
                        <div class="wf-field">
                            <label class="wf-label">Тип закупки</label>
                            <select class="wf-input" @bind="_edits[r.Id].TypeOfPurchaseId" @bind:after="() => SaveAsync(r.Id)">
                                <option value="">— не выбран —</option>
                                @foreach (var t in _types)
                                {
                                    <option value="@t.Id">@t.Name</option>
                                }
                            </select>
                        </div>
                        <div class="wf-field">
                            <label class="wf-label">Место поставки</label>
                            <textarea class="wf-area" @bind="_edits[r.Id].PlaceOfDelivery" @bind:after="() => SaveAsync(r.Id)"></textarea>
                        </div>
                        <div class="wf-field">
                            <label class="wf-label">Номер резерва</label>
                            <input class="wf-input" @bind="_edits[r.Id].ReserveNumber" @bind:after="() => SaveAsync(r.Id)" />
                        </div>
                        <div class="wf-field">
                            <label class="wf-label">Статус резерва B2B</label>
                            <select class="wf-input" @bind="_edits[r.Id].B2BStatusId" @bind:after="() => SaveAsync(r.Id)">
                                <option value="">— не выбран —</option>
                                @foreach (var b in _b2b)
                                {
                                    <option value="@b.Id">@b.Name</option>
                                }
                            </select>
                        </div>
                        <div class="wf-field">
                            <label class="wf-label">Нац режим</label>
                            <input class="wf-input" @bind="_edits[r.Id].NationalMode" @bind:after="() => SaveAsync(r.Id)" />
                        </div>
                        <div class="wf-field">
                            <label class="wf-label">Дата торгов</label>
                            <input type="datetime-local" class="wf-input" @bind="_edits[r.Id].BiddingDate" @bind:format="yyyy-MM-dd'T'HH:mm" @bind:after="() => SaveAsync(r.Id)" />
                        </div>
                        <div class="wf-field">
                            <label class="wf-label">НМЦК</label>
                            <input type="number" class="wf-input" @bind="_edits[r.Id].NMCK" @bind:after="() => SaveAsync(r.Id)" />
                        </div>
                        <div class="wf-field">
                            <label class="wf-label">Наша минимальная сумма</label>
                            <input type="number" class="wf-input" @bind="_edits[r.Id].MinPrice" @bind:after="() => SaveAsync(r.Id)" />
                        </div>
                        <div class="wf-field">
                            <label class="wf-label">Срок поставки</label>
                            <input class="wf-input" @bind="_edits[r.Id].DeliveryTime" @bind:after="() => SaveAsync(r.Id)" />
                        </div>
                        <div class="wf-field">
                            <label class="wf-label">Примечания</label>
                            <textarea class="wf-area" @bind="_edits[r.Id].Note" @bind:after="() => SaveAsync(r.Id)"></textarea>
                        </div>
                        @if (_stage == 12)
                        {
                            <div class="wf-field">
                                <label class="wf-label">Звони</label>
                                <label style="display:flex;align-items:center;gap:6px;font-size:14px">
                                    <input type="checkbox" style="width:18px;height:18px" @bind="_edits[r.Id].IsCall" @bind:after="() => SaveAsync(r.Id)" />
                                    <span>📞 Звони</span>
                                </label>
                            </div>
                        }
                    </div>
                }
                @* ===== Этап 3 «Подача заявки на площадку»: те же поля, только чтение ===== *@
                else if (_stage == 3)
                {
                    <div class="wf-grid">
                        <div class="wf-field"><label class="wf-label">Наименование</label><div class="wf-readonly">@r.NameLink</div></div>
                        <div class="wf-field"><label class="wf-label">Заказчик</label><div class="wf-readonly">@r.Customer</div></div>
                        <div class="wf-field"><label class="wf-label">Тип закупки</label><div class="wf-readonly">@r.TypeOfPurchaseName</div></div>
                        <div class="wf-field"><label class="wf-label">Место поставки</label><div class="wf-readonly">@r.PlaceOfDelivery</div></div>
                        <div class="wf-field"><label class="wf-label">Номер резерва</label><div class="wf-readonly">@r.ReserveNumber</div></div>
                        <div class="wf-field"><label class="wf-label">Статус резерва B2B</label><div class="wf-readonly">@r.B2BStatusName</div></div>
                        <div class="wf-field"><label class="wf-label">Нац режим</label><div class="wf-readonly">@r.NationalMode</div></div>
                        <div class="wf-field"><label class="wf-label">Дата торгов</label><div class="wf-readonly">@Fmt(r.BiddingDate)</div></div>
                        <div class="wf-field"><label class="wf-label">НМЦК</label><div class="wf-readonly">@r.NMCK.ToString("N2")</div></div>
                        <div class="wf-field"><label class="wf-label">Наша минимальная сумма</label><div class="wf-readonly">@r.MinPrice.ToString("N2")</div></div>
                        <div class="wf-field"><label class="wf-label">Срок поставки</label><div class="wf-readonly">@r.DeliveryTime</div></div>
                        <div class="wf-field"><label class="wf-label">Примечания</label><div class="wf-readonly">@r.Note</div></div>
                    </div>
                }
                @* ===== Этап 4 «Торги»: наименование/заказчик/тип — чтение, дата торгов — редактируется;
                      при флажке «Звони» подсвечивается наша минимальная сумма ===== *@
                else if (_stage == 4)
                {
                    <div class="wf-grid">
                        <div class="wf-field"><label class="wf-label">Наименование</label><div class="wf-readonly">@r.NameLink</div></div>
                        <div class="wf-field"><label class="wf-label">Заказчик</label><div class="wf-readonly">@r.Customer</div></div>
                        <div class="wf-field"><label class="wf-label">Тип закупки</label><div class="wf-readonly">@r.TypeOfPurchaseName</div></div>
                        <div class="wf-field">
                            <label class="wf-label">Дата и время торгов</label>
                            <input type="datetime-local" class="wf-input" @bind="_edits[r.Id].BiddingDate" @bind:format="yyyy-MM-dd'T'HH:mm" @bind:after="() => SaveAsync(r.Id)" />
                        </div>
                        <div class="wf-field">
                            <label class="wf-label">Наша минимальная сумма</label>
                            <div class="wf-readonly @(r.IsCall ? "wf-call" : "")">@r.MinPrice.ToString("N2")</div>
                            @if (r.IsCall)
                            {
                                <span class="wf-call-badge">📞 Звони</span>
                            }
                        </div>
                    </div>
                }
                @* ===== Остальные этапы (5–10): прежняя форма ===== *@
                else
                {
                    <div class="wf-grid">
                        <div class="wf-field"><label class="wf-label">Наименование</label><textarea class="wf-area" @bind="_edits[r.Id].NameLink" @bind:after="() => SaveAsync(r.Id)"></textarea></div>
                        <div class="wf-field"><label class="wf-label">Заказчик</label><textarea class="wf-area" @bind="_edits[r.Id].Customer" @bind:after="() => SaveAsync(r.Id)"></textarea></div>
                        <div class="wf-field"><label class="wf-label">НМЦК</label><input type="number" class="wf-input" @bind="_edits[r.Id].NMCK" @bind:after="() => SaveAsync(r.Id)" /></div>
                        <div class="wf-field"><label class="wf-label">Дата торгов</label><input class="wf-input" value="@Fmt(r.BiddingDate)" disabled /></div>
                        <div class="wf-field"><label class="wf-label">Резерв 1С</label><input class="wf-input" @bind="_edits[r.Id].ReserveNumber" @bind:after="() => SaveAsync(r.Id)" /></div>
                        <div class="wf-field"><label class="wf-label">Место на торгах</label><input class="wf-input" @bind="_edits[r.Id].Place" @bind:after="() => SaveAsync(r.Id)" /></div>
                        <div class="wf-field"><label class="wf-label">Место поставки</label><textarea class="wf-area" @bind="_edits[r.Id].PlaceOfDelivery" @bind:after="() => SaveAsync(r.Id)"></textarea></div>
                        <div class="wf-field"><label class="wf-label">Итог. цена</label><input type="number" class="wf-input" @bind="_edits[r.Id].ResultPrice" @bind:after="() => SaveAsync(r.Id)" /></div>
                        <div class="wf-field"><label class="wf-label">Победитель</label><input class="wf-input" @bind="_edits[r.Id].Winner" @bind:after="() => SaveAsync(r.Id)" /></div>
                        <div class="wf-field"><label class="wf-label">Примечание</label><textarea class="wf-area" @bind="_edits[r.Id].Note" @bind:after="() => SaveAsync(r.Id)"></textarea></div>
                    </div>
                }

                <div class="toolbar" style="margin-top:10px;flex-wrap:wrap;gap:6px;align-items:center">
                    <span class="muted" style="font-size:12px">Изменения сохраняются автоматически</span>
                    @if (_stage == 1)
                    {
                        <button class="btn" @onclick="() => Advance(r.Id, 2)">→ 1.2 Резерв</button>
                        <button class="btn" @onclick="() => Advance(r.Id, 14)">→ 2 Согласование</button>
                    }
                    else if (_stage == 2)
                    {
                        <button class="btn" @onclick="() => Advance(r.Id, 3)">→ 2 Согласование</button>
                    }
                    else if (_stage == 12)
                    {
                        <button class="btn" @onclick="() => Advance(r.Id, 13)">Согласовано → 3 Подача</button>
                    }
                    else if (_stage == 3)
                    {
                        <button class="btn" @onclick="() => Advance(r.Id, 4)">Размещена → 4 Торги</button>
                    }
                    else if (_stage == 4)
                    {
                        <button class="btn" @onclick="() => Advance(r.Id, 5)">Выиграл →</button>
                        <button class="btn btn--danger" @onclick="() => Advance(r.Id, 6)">Проиграл</button>
                    }
                    else if (_stage == 5)
                    {
                        <button class="btn" @onclick="() => Advance(r.Id, 7)">Подписан →</button>
                    }
                    else if (_stage == 6)
                    {
                        <button class="btn" @onclick="() => Advance(r.Id, 8)">→ Логистика</button>
                    }
                    else if (_stage == 7)
                    {
                        <button class="btn" @onclick="() => Advance(r.Id, 9)">→ Ожидание доставки</button>
                    }
                    else if (_stage == 8)
                    {
                        <button class="btn" @onclick="() => Advance(r.Id, 10)">→ Приемка</button>
                    }
                    else if (_stage == 9)
                    {
                        <button class="btn" @onclick="() => Advance(r.Id, 11)">→ Оплата</button>
                    }
                    else if (_stage == 10)
                    {
                        <button class="btn" @onclick="() => Advance(r.Id, 12)">Завершить</button>
                    }
                </div>
            </div>
        </div>
    }
}

@code {
    private List<WorkflowRow> _rows = new();
    private readonly Dictionary<int, WorkflowEdit> _edits = new();
    private IReadOnlyList<DictionaryItemDto> _types = Array.Empty<DictionaryItemDto>();
    private IReadOnlyList<DictionaryItemDto> _b2b = Array.Empty<DictionaryItemDto>();
    private bool _busy;
    private bool _loading = true;
    private int _stage = 1;
    private string? _error;
    private ChangeActor _actor = new("user", "Пользователь");
    private HashSet<int> _allowedStages = new();
    private bool _isTenderHead;
    private int _biddingTomorrow;
    private int _biddingToday;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            var name = state.User.Identity?.Name ?? "Пользователь";
            _actor = new ChangeActor(name, name);

            // Стадии, разрешённые пользователю по его ролям (настройка в /roles → «Стадии воркфлоу»).
            var uid = state.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
            var stages = await RolePerms.GetEffectiveStagesAsync(uid);
            _allowedStages = stages.ToHashSet();

            // Словари для выпадающих списков «Тип закупки» и «Статус резерва B2B».
            _types = await DictSvc.GetTypesOfPurchaseAsync();
            _b2b = await DictSvc.GetB2BStatusesAsync();

            // Всплывающее уведомление о предстоящих торгах — для роли «Руководитель тендерного отдела».
            _isTenderHead = state.User.IsInRole("TenderHead");
            if (_isTenderHead)
            {
                (_biddingTomorrow, _biddingToday) = await WorkflowSvc.GetUpcomingBiddingCountsAsync();
            }

            // Стадия по умолчанию — первая из разрешённых.
            var firstAllowed = WorkflowStages.All.FirstOrDefault(s => _allowedStages.Contains(s.Id));
            if (_allowedStages.Contains(firstAllowed.Id))
            {
                _stage = firstAllowed.Id;
            }

            await LoadAsync();
        }
        catch
        {
            // При пререндере (F5) контекст авторизации/БД может быть недоступен и запрос
            // завершился бы 500. Интерактивная цепь выполнит инициализацию повторно и
            // отрисует страницу, поэтому здесь исключение достаточно проглотить.
        }
    }

    private async Task LoadAsync()
    {
        _busy = true;
        try
        {
            _rows = (await WorkflowSvc.GetAsync()).ToList();
            _edits.Clear();
            foreach (var r in _rows)
            {
                _edits[r.Id] = new WorkflowEdit
                {
                    NameLink = r.NameLink,
                    Customer = r.Customer,
                    NMCK = r.NMCK,
                    ReserveNumber = r.ReserveNumber,
                    Place = r.Place ?? string.Empty,
                    PlaceOfDelivery = r.PlaceOfDelivery,
                    ResultPrice = r.ResultPrice,
                    Winner = r.Winner,
                    Note = r.Note,
                    Attachments = r.Attachments ?? string.Empty,
                    TypeOfPurchaseId = r.TypeOfPurchaseId,
                    B2BStatusId = r.B2BStatusId,
                    NationalMode = r.NationalMode,
                    BiddingDate = r.BiddingDate,
                    MinPrice = r.MinPrice,
                    DeliveryTime = r.DeliveryTime,
                    IsCall = r.IsCall
                };
            }
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; _loading = false; }
    }

    private void SetStage(int stage) => _stage = stage;

    private string TabClass(int stage) => _stage == stage ? "btn btn-primary" : "btn";

    private int Count(int stage) => _rows.Count(r => r.Stage == stage);

    private List<WorkflowRow> Rows() => _rows.Where(r => r.Stage == _stage).ToList();

    private static string Fmt(DateTime? d) => d?.ToString("dd.MM.yyyy HH:mm") ?? string.Empty;

    private static string[] SplitAttachments(string value) =>
        string.IsNullOrWhiteSpace(value) ? Array.Empty<string>() : value.Split(';', StringSplitOptions.RemoveEmptyEntries);

    // Автосохранение строки (как в реестре): вызывается при уходе с поля, без полной перезагрузки.
    private async Task SaveAsync(int id)
    {
        _error = null;
        var result = await WorkflowSvc.UpdateAsync(id, _edits[id]);
        if (!result.Success) { _error = result.Error; }
    }

    private async Task DeleteAttachment(int id, string path)
    {
        _error = null;
        var result = await WorkflowSvc.DeleteAttachmentAsync(id, path);
        if (!result.Success) { _error = result.Error; return; }
        await LoadAsync();
    }

    private async Task Advance(int id, int code)
    {
        _error = null;
        var result = await WorkflowSvc.AdvanceAsync(id, code, _actor);
        if (!result.Success) { _error = result.Error; return; }
        await LoadAsync();
    }

    private async Task OnFileAsync(InputFileChangeEventArgs ev, int id)
    {
        _error = null;
        try
        {
            foreach (var file in ev.GetMultipleFiles(10))
            {
                await using var stream = file.OpenReadStream(20 * 1024 * 1024);
                var result = await WorkflowSvc.SaveAttachmentAsync(id, file.Name, stream);
                if (!result.Success) { _error = result.Error; }
            }
            await LoadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }
}
