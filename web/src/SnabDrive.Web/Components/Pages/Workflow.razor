    // Этап 7: сохранить отдельный файл для оповещения филиала.
    private async Task OnBranchFileAsync(InputFileChangeEventArgs ev, int id)
    {
        _error = null;
        try
        {
            var file = ev.File;

            // Проверяем размер до чтения: на превышении Blazor бросает исключение на английском.
            if (AttachmentLimits.IsTooBig(file.Size))
            {
                _error = AttachmentLimits.TooBigMessage(file.Name, file.Size);
                return;
            }

            await using var stream = file.OpenReadStream(AttachmentLimits.MaxFileSizeBytes);
            var result = await WorkflowSvc.SaveBranchFileAsync(id, file.Name, stream);
            if (!result.Success) { _error = result.Error; }
            await LoadAsync();
        }
        catch (Exception ex) { _error = ErrorText.Describe(ex); }
    }

    // Этап 7: оповестить филиал в Битрикс24 и перевести на следующий этап.
    private async Task NotifyBranch(int id)
    {
        _error = null;
        var result = await WorkflowSvc.NotifyBranchAsync(id, _actor);
        if (!result.Success) { _error = result.Error; return; }
        await LoadAsync();
    }

    // Этап 9: окно «Проблема с приемкой» с описанием.
    private void OpenReturn(int id) { _returnFor = id; _returnReason = string.Empty; }

    private void CloseReturn() { _returnFor = null; _returnReason = string.Empty; }

    private async Task SubmitReturn()
    {
        if (_returnFor is null) { return; }
        _error = null;
        var result = await WorkflowSvc.ReturnAsync(_returnFor.Value, _returnReason, _actor);
        if (!result.Success) { _error = result.Error; return; }
        CloseReturn();
        await LoadAsync();
    }

