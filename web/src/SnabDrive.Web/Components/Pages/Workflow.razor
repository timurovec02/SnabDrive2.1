        if (!result.Success) { _error = result.Error; return; }
        await LoadAsync();
    }

    /// <summary>
    /// Закрыть этап 6 «Контракт» вручную. Стадия закупки не меняется: контракт идёт
    /// параллельно с этапом 5, и только после его закрытия этап 5 можно завершить.
    /// </summary>
    private async Task CloseContract(int id)
    {
        _error = null;
        var result = await WorkflowSvc.CloseContractAsync(id, _actor);
        if (!result.Success) { _error = result.Error; return; }
        var stage5Done = _rows.FirstOrDefault(x => x.Id == id)?.Stage5ClosedAtUtc is not null;
        _notice = stage5Done
            ? "Этап «6. Контракт» закрыт — закупка переведена на этап «7. Лог.документы»."
            : "Этап «6. Контракт» закрыт.";
        await LoadAsync();
    }

    /// <summary>
    /// Завершить этап 5 «Перемещение товара». Закупка сразу уходит из вкладки этапа 5,
    /// а на этап 7 попадает после закрытия этапа 6 «Контракт» (или немедленно, если он уже закрыт).
    /// </summary>
    private async Task CompleteMovement(int id)
    {
        _error = null;
        var contractClosed = _rows.FirstOrDefault(x => x.Id == id)?.ContractClosedAtUtc is not null;

        var result = await WorkflowSvc.CompleteMovementAsync(id, _actor);
        if (!result.Success) { _error = result.Error; return; }

        _notice = contractClosed
            ? "Этап 5 завершён — закупка переведена на этап «7. Лог.документы»."
            : "Этап 5 завершён. На этап 7 закупка попадёт после закрытия этапа «6. Контракт».";
        await LoadAsync();
    }

    /// <summary>
    /// Проверка этапа 4 «Торги»: «Выиграл» и «Проиграл» доступны только после того,
    /// как указаны место на торгах и итоговая цена (то же проверяет и сервис).
    /// </summary>
    private static bool Stage4Ready(WorkflowEdit e)
        => !string.IsNullOrWhiteSpace(e.Place) && e.ResultPrice > 0;

    private async Task OnFileAsync(InputFileChangeEventArgs ev, int id)
    {
        _error = null;
        try
        {
            foreach (var file in ev.GetMultipleFiles(10))
            {
                // Проверяем размер до чтения: на превышении Blazor бросает исключение на английском.
                if (AttachmentLimits.IsTooBig(file.Size))
                {
                    _error = AttachmentLimits.TooBigMessage(file.Name, file.Size);
                    continue;
                }

                await using var stream = file.OpenReadStream(AttachmentLimits.MaxFileSizeBytes);
                var result = await WorkflowSvc.SaveAttachmentAsync(id, file.Name, stream);
                if (!result.Success) { _error = result.Error; }
            }
            await LoadAsync();
        }
        catch (Exception ex) { _error = ErrorText.Describe(ex); }
    }
