    /// <summary>Выбор стадии для ручного переноса (хранится до нажатия «Переместить»).</summary>
    private void OnStageMovePick(int id, ChangeEventArgs ev)
    {
        if (int.TryParse(ev.Value?.ToString(), out var stage))
        {
            _stageMoves[id] = stage;
        }
    }

    // Ручной перенос закупки на любую стадию (право «Менять стадию закупок»).
    private async Task MoveToStage(int id)
    {
        _error = null;
        _notice = null;

        var row = _rows.FirstOrDefault(x => x.Id == id);
        if (row is null)
        {
            _error = "Запись не найдена — обновите страницу и попробуйте снова.";
            return;
        }

        if (!_stageMoves.TryGetValue(id, out var stage))
        {
            _error = "Сначала выберите стадию в списке «Перенести на стадию».";
            return;
        }

        if (stage == row.Stage)
        {
            _error = $"Закупка уже на стадии «{WorkflowStages.Name(stage)}» — выберите другую.";
            return;
        }

        try
        {
            var result = await WorkflowSvc.SetStageAsync(id, stage, _actor);
            if (!result.Success)
            {
                _error = result.Error;
                return;
            }
        }
        catch (Exception ex)
        {
            _error = "Не удалось перенести закупку: " + ErrorText.Describe(ex);
            return;
        }

        _stageMoves.Remove(id);
        _notice = $"Закупка #{id} переведена на стадию «{WorkflowStages.Name(stage)}».";
        await LoadAsync();
    }

    private async Task Advance(int id, int code)
    {
        _error = null;
