@page "/workflow"
@using System.Linq
@using System.Security.Claims
@using SnabDrive.Web.Domain
@using SnabDrive.Web.Services
@attribute [Authorize]
@inject IWorkflowService WorkflowSvc
@inject AuthenticationStateProvider AuthStateProvider

<h1 class="page-title">Задачи по закупкам</h1>
<p class="page-subtitle">Воркфлоу по стадиям. Поля редактируются, кнопка переводит закупку на следующую стадию.</p>

@if (_error is not null)
{
    <div class="alert alert-error">@_error</div>
}

<div class="toolbar" style="flex-wrap:wrap;gap:6px;margin:12px 0">
    @foreach (var st in WorkflowStages.All)
    {
        <button class="@TabClass(st.Id)" @onclick="() => SetStage(st.Id)">@st.Name (@Count(st.Id))</button>
    }
    <div class="toolbar-spacer"></div>
    <button class="btn" disabled="@_busy" @onclick="LoadAsync">Обновить</button>
</div>

@if (_loading)
{
    <p class="muted">Загрузка…</p>
}
else if (!Rows().Any())
{
    <p class="muted">Нет закупок на этой стадии.</p>
}
else
{
    @foreach (var r in Rows())
    {
        <div class="card" style="margin-bottom:12px">
            <div class="card-body">
                <div class="row g-2">
                    <div class="col"><label class="form-label">Наименование</label><input class="form-control" @bind="_edits[r.Id].NameLink" /></div>
                    <div class="col"><label class="form-label">Заказчик</label><input class="form-control" @bind="_edits[r.Id].Customer" /></div>
                    <div class="col"><label class="form-label">НМЦК</label><input type="number" class="form-control" @bind="_edits[r.Id].NMCK" /></div>
                    <div class="col"><label class="form-label">Дата торгов</label><input class="form-control" value="@Fmt(r.BiddingDate)" disabled /></div>
                </div>
                <div class="row g-2">
                    <div class="col"><label class="form-label">Резерв 1С</label><input class="form-control" @bind="_edits[r.Id].ReserveNumber" /></div>
                    <div class="col"><label class="form-label">Место</label><input class="form-control" @bind="_edits[r.Id].Place" /></div>
                    <div class="col"><label class="form-label">Место поставки</label><input class="form-control" @bind="_edits[r.Id].PlaceOfDelivery" /></div>
                    <div class="col"><label class="form-label">Итог. цена</label><input type="number" class="form-control" @bind="_edits[r.Id].ResultPrice" /></div>
                </div>
                <div class="row g-2">
                    <div class="col"><label class="form-label">Победитель</label><input class="form-control" @bind="_edits[r.Id].Winner" /></div>
                    <div class="col"><label class="form-label">Примечание</label><input class="form-control" @bind="_edits[r.Id].Note" /></div>
                </div>

                <div style="margin-top:8px">
                    <label class="form-label">Вложения</label>
                    <div>
                        @foreach (var a in SplitAttachments(_edits[r.Id].Attachments))
                        {
                            <a href="@a" target="_blank" rel="noopener" class="badge badge--info" style="margin-right:6px">@System.IO.Path.GetFileName(a)</a>
                        }
                    </div>
                    <InputFile OnChange="ev => OnFileAsync(ev, r.Id)" class="form-control" style="max-width:360px;margin-top:4px" />
                </div>

                <div class="toolbar" style="margin-top:10px;flex-wrap:wrap;gap:6px">
                    <button class="btn btn-primary" @onclick="() => SaveAsync(r.Id)">Сохранить</button>
                    @if (_stage == 1)
                    {
                        <button class="btn" @onclick="() => Advance(r.Id, 1)">→ Подача заявки</button>
                        <button class="btn" @onclick="() => Advance(r.Id, 2)">Дозаполнить резерв</button>
                    }
                    else if (_stage == 2)
                    {
                        <button class="btn" @onclick="() => Advance(r.Id, 3)">Передать →</button>
                    }
                    else if (_stage == 3)
                    {
                        <button class="btn" @onclick="() => Advance(r.Id, 4)">Подана →</button>
                    }
                    else if (_stage == 4)
                    {
                        <button class="btn" @onclick="() => Advance(r.Id, 5)">Выиграл →</button>
                        <button class="btn btn--danger" @onclick="() => Advance(r.Id, 6)">Проиграл</button>
                    }
                    else if (_stage == 5)
                    {
                        <button class="btn" @onclick="() => Advance(r.Id, 7)">Подписан →</button>
                    }
                    else if (_stage == 6)
                    {
                        <button class="btn" @onclick="() => Advance(r.Id, 8)">→ Логистика</button>
                    }
                    else if (_stage == 7)
                    {
                        <button class="btn" @onclick="() => Advance(r.Id, 9)">→ Ожидание доставки</button>
                    }
                    else if (_stage == 8)
                    {
                        <button class="btn" @onclick="() => Advance(r.Id, 10)">→ Приемка</button>
                    }
                    else if (_stage == 9)
                    {
                        <button class="btn" @onclick="() => Advance(r.Id, 11)">→ Оплата</button>
                    }
                    else if (_stage == 10)
                    {
                        <button class="btn" @onclick="() => Advance(r.Id, 12)">Завершить</button>
                    }
                </div>
            </div>
        </div>
    }
}

@code {
    private List<WorkflowRow> _rows = new();
    private readonly Dictionary<int, WorkflowEdit> _edits = new();
    private bool _busy;
    private bool _loading = true;
    private int _stage = 1;
    private string? _error;
    private ChangeActor _actor = new("user", "Пользователь");

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var name = state.User.Identity?.Name ?? "Пользователь";
        _actor = new ChangeActor(name, name);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _busy = true;
        try
        {
            _rows = (await WorkflowSvc.GetAsync()).ToList();
            _edits.Clear();
            foreach (var r in _rows)
            {
                _edits[r.Id] = new WorkflowEdit
                {
                    NameLink = r.NameLink,
                    Customer = r.Customer,
                    NMCK = r.NMCK,
                    ReserveNumber = r.ReserveNumber,
                    Place = r.Place ?? string.Empty,
                    PlaceOfDelivery = r.PlaceOfDelivery,
                    ResultPrice = r.ResultPrice,
                    Winner = r.Winner,
                    Note = r.Note,
                    Attachments = r.Attachments ?? string.Empty
                };
            }
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; _loading = false; }
    }

    private void SetStage(int stage) => _stage = stage;

    private string TabClass(int stage) => _stage == stage ? "btn btn-primary" : "btn";

    private int Count(int stage) => _rows.Count(r => r.Stage == stage);

    private List<WorkflowRow> Rows() => _rows.Where(r => r.Stage == _stage).ToList();

    private static string Fmt(DateTime? d) => d?.ToString("dd.MM.yyyy") ?? string.Empty;

    private static string[] SplitAttachments(string value) =>
        string.IsNullOrWhiteSpace(value) ? Array.Empty<string>() : value.Split(';', StringSplitOptions.RemoveEmptyEntries);

    private async Task SaveAsync(int id)
    {
        _error = null;
        var result = await WorkflowSvc.UpdateAsync(id, _edits[id]);
        if (!result.Success) { _error = result.Error; return; }
        await LoadAsync();
    }

    private async Task Advance(int id, int code)
    {
        _error = null;
        var result = await WorkflowSvc.AdvanceAsync(id, code, _actor);
        if (!result.Success) { _error = result.Error; return; }
        await LoadAsync();
    }

    private async Task OnFileAsync(InputFileChangeEventArgs ev, int id)
    {
        _error = null;
        try
        {
            foreach (var file in ev.GetMultipleFiles(10))
            {
                await using var stream = file.OpenReadStream(20 * 1024 * 1024);
                var result = await WorkflowSvc.SaveAttachmentAsync(id, file.Name, stream);
                if (!result.Success) { _error = result.Error; }
            }
            await LoadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }
}
