@page "/registry"
@attribute [Authorize]
@implements IDisposable
@inject IRegistryService RegistryService
@inject IColumnAccessService ColumnAccess
@inject IDictionaryService Dictionaries
@inject AuthenticationStateProvider AuthStateProvider
@inject IRegistryEventBus EventBus
@inject IToastService Toasts
@inject NavigationManager Navigation

<PageTitle>Реестр — SnabDrive</PageTitle>

<div class="page">
    <div class="page__header">
        <div>
            <h1>Реестр закупок</h1>
            <p class="page__hint">
                Найдено @_data.TotalCount записей · страница @_data.Page из @Math.Max(_data.TotalPages, 1)
                @if (_realtimeOn)
                {
                    <span class="live-badge" title="Таблица обновляется автоматически">● live</span>
                }
            </p>
        </div>

        <div class="toolbar">
            <div class="search">
                <input type="search" class="input" placeholder="Поиск по всем полям…"
                       value="@_query.Search" @oninput="OnSearchInput" />
                @if (!string.IsNullOrEmpty(_query.Search))
                {
                    <button type="button" class="btn btn--ghost" @onclick="ClearSearch" title="Очистить поиск">×</button>
                }
            </div>

            <select class="input input--small" value="@_query.PageSize.ToString()" @onchange="OnPageSizeChanged">
                <option value="25">25</option>
                <option value="50">50</option>
                <option value="100">100</option>
                <option value="200">200</option>
            </select>

            <div class="columns-picker">
                <button type="button" class="btn" @onclick="() => _columnsOpen = !_columnsOpen">Колонки</button>
                @if (_columnsOpen)
                {
                    <div class="columns-picker__panel">
                        @foreach (var column in RegistryColumns.All.Where(c => _access.CanView(c.Key)))
                        {
                            <label class="checkbox-label">
                                <input type="checkbox" checked="@_visible.Contains(column.Key)"
                                       @onchange="e => ToggleColumn(column.Key, e)" />
                                @column.Title
                            </label>
                        }
                    </div>
                }
            </div>

            <button type="button" class="btn btn--primary" @onclick="CreateAsync" disabled="@_busy">＋ Добавить</button>
            <button type="button" class="btn" @onclick="EditSelectedAsync" disabled="@(_busy || _selected is null)">✎ Изменить</button>
            <button type="button" class="btn btn--danger" @onclick="AskDelete" disabled="@(_busy || _selected is null)">🗑 Удалить</button>

            @if (_isAdmin)
            {
                <button type="button" class="btn" @onclick="AskArchive" disabled="@(_busy || _selected is null)">🗄 В архив</button>
            }

            <button type="button" class="btn btn--ghost" @onclick="ReloadAsync" title="Обновить данные">⟳</button>
            <a class="btn btn--ghost" href="@ExportUrl" title="Выгрузить в CSV">⭳ CSV</a>
        </div>
    </div>

    <div class="page__section">
        <RegistryGrid Rows="@_data.Items"
                      Columns="@_visibleColumns"
                      SortKey="@_query.SortBy"
                      SortDescending="@_query.SortDescending"
                      OnSortChanged="ToggleSortAsync"
                      Filters="@_filters"
                      OnFilterChanged="OnFilterChangedAsync"
                      TypesOfPurchase="@_typesOfPurchase"
                      B2BStatuses="@_b2bStatuses"
                      ExecutionStatuses="@_executionStatuses"
                      CellColors="@_colors"
                      SelectedId="@(_selected?.Id ?? 0)"
                      SelectedCellKey="@_selectedCellKey"
                      IsLoading="@_loading"
                      OnRowSelected="SelectRow"
                      OnCellSelected="SelectCell" />
    </div>

    <div class="pager">
        <button type="button" class="btn btn--small" @onclick="() => GoToPageAsync(1)" disabled="@(!_data.HasPrevious)">«</button>
        <button type="button" class="btn btn--small" @onclick="() => GoToPageAsync(_data.Page - 1)" disabled="@(!_data.HasPrevious)">‹</button>
        <span class="pager__info">@_data.FirstItemIndex–@_data.LastItemIndex из @_data.TotalCount</span>
        <button type="button" class="btn btn--small" @onclick="() => GoToPageAsync(_data.Page + 1)" disabled="@(!_data.HasNext)">›</button>
        <button type="button" class="btn btn--small" @onclick="() => GoToPageAsync(_data.TotalPages)" disabled="@(!_data.HasNext)">»</button>
    </div>

    <div class="color-bar">
        <span class="color-bar__label">Подсветка ячейки:</span>
        @if (_selectedCellKey is null)
        {
            <span class="color-bar__hint">выберите ячейку в таблице</span>
        }
        else
        {
            <span class="color-bar__hint">@_selectedCellTitle</span>
            @foreach (var color in Palette)
            {
                <button type="button" class="color-swatch" style="@($"background:{color}")"
                        title="Покрасить в @color"
                        @onclick="() => ApplyColorAsync(color)"></button>
            }
            <button type="button" class="btn btn--small" @onclick="() => ApplyColorAsync(null)">Сбросить</button>
        }
    </div>
</div>

@if (_showEditor && _editModel is not null)
{
    <RegistryEditDialog Model="@_editModel"
                        Title="@_editorTitle"
                        GlobalError="@_editorError"
                        IsBusy="@_busy"
                        TypesOfPurchase="@_typesOfPurchase"
                        B2BStatuses="@_b2bStatuses"
                        ExecutionStatuses="@_executionStatuses"
                        Access="@_access"
                        OnSave="SaveAsync"
                        OnClose="CloseEditor" />
}

@if (_confirm is not null)
{
    <ConfirmDialog Title="@_confirm.Value.Title"
                   Message="@_confirm.Value.Message"
                   ConfirmText="@_confirm.Value.ConfirmText"
                   OnConfirm="@_confirm.Value.OnConfirm"
                   OnCancel="@(() => _confirm = null)" />
}

@code {
    private static readonly string[] Palette =
    {
        "#ffeb3b", "#ffcdd2", "#c8e6c9", "#bbdefb", "#ffe0b2", "#e1bee7", "#b2dfdb", "#d7ccc8"
    };

    private ColumnAccessMap _access = ColumnAccessMap.Full;
    private RegistryQuery _query = new();
    private Dictionary<string, string> _filters = new(StringComparer.OrdinalIgnoreCase);
    private PagedResult<RegistryRowDto> _data = PagedResult<RegistryRowDto>.Empty(1, 50);
    private IReadOnlyDictionary<string, string> _colors = new Dictionary<string, string>();

    private List<DictionaryItemDto> _typesOfPurchase = new();
    private List<DictionaryItemDto> _b2bStatuses = new();
    private List<DictionaryItemDto> _executionStatuses = new();

    private HashSet<string> _visible = new(StringComparer.OrdinalIgnoreCase);
    private List<RegistryColumn> _visibleColumns = new();

    private RegistryRowDto? _selected;
    private string? _selectedCellKey;
    private string _selectedCellTitle = string.Empty;

    private bool _loading;
    private bool _busy;
    private bool _isAdmin;
    private bool _columnsOpen;
    private bool _realtimeOn;

    private RegeditUpsertRequest? _editModel;
    private int? _editingId;
    private string _editorTitle = string.Empty;
    private string? _editorError;
    private bool _showEditor;

    private ConfirmRequest? _confirm;
    private CancellationTokenSource? _searchDebounce;
    private ChangeActor _actor = ChangeActor.System;

    private string ExportUrl
    {
        get
        {
            var parts = new List<string> { $"pageSize={RegistryQuery.MaxPageSize}" };

            if (!string.IsNullOrWhiteSpace(_query.Search))
            {
                parts.Add($"search={Uri.EscapeDataString(_query.Search)}");
            }

            foreach (var filter in _filters.Where(f => !string.IsNullOrWhiteSpace(f.Value)))
            {
                parts.Add($"f[{Uri.EscapeDataString(filter.Key)}]={Uri.EscapeDataString(filter.Value)}");
            }

            return "/api/regedit/export?" + string.Join('&', parts);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _visible = RegistryColumns.DefaultVisible.Select(c => c.Key).ToHashSet(StringComparer.OrdinalIgnoreCase);
        RebuildVisibleColumns();

        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        _isAdmin = state.User.IsInRole(AppRoles.Admin);

        var userId = state.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "-";
        _access = await ColumnAccess.GetAsync(userId);
        _actor = state.User.ToActor() with { Access = _access };

        EventBus.Changed += OnRegistryChanged;
        _realtimeOn = true;

        _typesOfPurchase = (await Dictionaries.GetTypesOfPurchaseAsync()).ToList();
        _b2bStatuses = (await Dictionaries.GetB2BStatusesAsync()).ToList();
        _executionStatuses = (await Dictionaries.GetExecutionStatusesAsync()).ToList();

        await ReloadAsync();
    }

    private void RebuildVisibleColumns()
    {
        _visibleColumns = RegistryColumns.All
            .Where(c => _visible.Contains(c.Key) && _access.CanView(c.Key))
            .ToList();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        try
        {
            _data = await RegistryService.QueryAsync(_query, _access);

            var ids = _data.Items.Select(r => r.ColorOwnerId).ToList();
            _colors = await RegistryService.GetCellColorsAsync(ids);

            if (_selected is not null && _data.Items.All(r => r.Id != _selected.Id))
            {
                _selected = null;
                _selectedCellKey = null;
            }
        }
        catch (Exception ex)
        {
            Toasts.Show($"Не удалось загрузить данные: {ex.Message}", ToastKind.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    // ------------------------------------------------------------ realtime

    private void OnRegistryChanged(RegistryChangeEvent changeEvent)
    {
        _ = InvokeAsync(async () =>
        {
            await ReloadAsync();
            StateHasChanged();
        });
    }

    // ------------------------------------------------------------ поиск и фильтры

    private async Task OnSearchInput(ChangeEventArgs args)
    {
        var value = args.Value?.ToString() ?? string.Empty;
        _query = _query with { Search = value, Page = 1 };

        _searchDebounce?.Cancel();
        _searchDebounce = new CancellationTokenSource();
        var token = _searchDebounce.Token;

        try
        {
            await Task.Delay(400, token);
            if (!token.IsCancellationRequested)
            {
                await ReloadAsync();
            }
        }
        catch (TaskCanceledException)
        {
            // ввели следующий символ — ждём новый debounce
        }
    }

    private async Task ClearSearch()
    {
        _searchDebounce?.Cancel();
        _query = _query with { Search = null, Page = 1 };
        await ReloadAsync();
    }

    private async Task OnFilterChangedAsync((string Key, string Value) change)
    {
        _filters[change.Key] = change.Value;
        _query = _query with { ColumnFilters = new Dictionary<string, string>(_filters), Page = 1 };
        await ReloadAsync();
    }

    private async Task OnPageSizeChanged(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var size))
        {
            _query = _query with { PageSize = size, Page = 1 };
            await ReloadAsync();
        }
    }

    private async Task ToggleSortAsync(string key)
    {
        if (string.Equals(_query.SortBy, key, StringComparison.OrdinalIgnoreCase))
        {
            _query = _query with { SortDescending = !_query.SortDescending };
        }
        else
        {
            _query = _query with { SortBy = key, SortDescending = false };
        }

        await ReloadAsync();
    }

    private async Task GoToPageAsync(int page)
    {
        if (page < 1 || page > Math.Max(_data.TotalPages, 1))
        {
            return;
        }

        _query = _query with { Page = page };
        await ReloadAsync();
    }

    private void ToggleColumn(string key, ChangeEventArgs args)
    {
        var isChecked = args.Value is bool b && b;

        if (isChecked)
        {
            _visible.Add(key);
        }
        else
        {
            _visible.Remove(key);
        }

        RebuildVisibleColumns();
    }

    // ------------------------------------------------------------ выделение и подсветка

    private void SelectRow(RegistryRowDto row)
    {
        _selected = row;
    }

    private void SelectCell(CellClickArgs args)
    {
        _selected = args.Row;
        _selectedCellKey = $"{args.RecordId}|{args.ColumnKey}";
        _selectedCellTitle = $"{args.Row.Id} · {RegistryColumns.Find(args.ColumnKey)?.Title ?? args.ColumnKey}";
    }

    private async Task ApplyColorAsync(string? color)
    {
        if (_selected is null || _selectedCellKey is null)
        {
            return;
        }

        var columnKey = _selectedCellKey.Split('|')[1];
        _busy = true;

        try
        {
            var result = await RegistryService.SetCellColorAsync(_selected.ColorOwnerId, columnKey, color, _actor);
            if (!result.Success)
            {
                Toasts.Show(result.Error ?? "Не удалось изменить подсветку", ToastKind.Error);
            }
        }
        catch (Exception ex)
        {
            Toasts.Show($"Ошибка подсветки: {ex.Message}", ToastKind.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    // ------------------------------------------------------------ CRUD

    private async Task CreateAsync()
    {
        _editModel = new RegeditUpsertRequest
        {
            BiddingDate = DateTime.Today,
            TypeOfPurchaseId = _typesOfPurchase.FirstOrDefault()?.Id,
            B2BStatusId = _b2bStatuses.FirstOrDefault()?.Id,
            ExecutionStatusId = _executionStatuses.FirstOrDefault()?.Id
        };
        _editingId = null;
        _editorTitle = "Новая запись";
        _editorError = null;
        _showEditor = true;
        await Task.CompletedTask;
    }

    private async Task EditSelectedAsync()
    {
        if (_selected is null)
        {
            return;
        }

        var model = await RegistryService.GetEditModelAsync(_selected.Id, _access);
        if (model is null)
        {
            Toasts.Show("Запись не найдена — возможно, её уже удалили.", ToastKind.Warning);
            await ReloadAsync();
            return;
        }

        _editModel = model;
        _editingId = _selected.Id;
        _editorTitle = $"Запись #{_selected.Id}";
        _editorError = null;
        _showEditor = true;
    }

    private async Task SaveAsync()
    {
        if (_editModel is null)
        {
            return;
        }

        _busy = true;
        _editorError = null;

        try
        {
            var result = _editingId is null
                ? await RegistryService.CreateAsync(_editModel, _actor)
                : await RegistryService.UpdateAsync(_editingId.Value, _editModel, _actor);

            if (result.Success)
            {
                Toasts.Show(_editingId is null ? "Запись добавлена" : "Изменения сохранены", ToastKind.Success);
                CloseEditor();
            }
            else
            {
                _editorError = result.Error;
                Toasts.Show(result.Error ?? "Не удалось сохранить запись", ToastKind.Error);
            }
        }
        catch (Exception ex)
        {
            _editorError = ex.Message;
            Toasts.Show($"Ошибка сохранения: {ex.Message}", ToastKind.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private void CloseEditor()
    {
        _showEditor = false;
        _editModel = null;
        _editingId = null;
        _editorError = null;
    }

    private void AskDelete()
    {
        if (_selected is null)
        {
            return;
        }

        var row = _selected;
        _confirm = new ConfirmRequest(
            "Удаление записи",
            $"Удалить запись «{row.NameLink}»? Действие необратимо.",
            "Удалить",
            async () =>
            {
                _confirm = null;
                await DeleteAsync(row);
            });
    }

    private async Task DeleteAsync(RegistryRowDto row)
    {
        _busy = true;
        try
        {
            var result = await RegistryService.DeleteAsync(row.Id, _actor);
            Toasts.Show(result.Success ? "Запись удалена" : result.Error ?? "Ошибка удаления",
                result.Success ? ToastKind.Success : ToastKind.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private void AskArchive()
    {
        if (_selected is null)
        {
            return;
        }

        var row = _selected;
        _confirm = new ConfirmRequest(
            "Архивация записи",
            $"Переместить запись «{row.NameLink}» в архив?",
            "В архив",
            async () =>
            {
                _confirm = null;
                _busy = true;
                try
                {
                    var result = await RegistryService.ArchiveAsync(row.Id, _actor);
                    Toasts.Show(result.Success ? "Запись перемещена в архив" : result.Error ?? "Ошибка архивации",
                        result.Success ? ToastKind.Success : ToastKind.Error);
                }
                finally
                {
                    _busy = false;
                }
            });
    }

    public void Dispose()
    {
        EventBus.Changed -= OnRegistryChanged;
        _searchDebounce?.Cancel();
        _searchDebounce?.Dispose();
    }

    private sealed record ConfirmRequest(string Title, string Message, string ConfirmText, Func<Task> OnConfirm);
}
