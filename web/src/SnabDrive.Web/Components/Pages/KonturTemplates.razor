@page "/kontur-templates"
@using System.Linq
@using System.Security.Claims
@using SnabDrive.Web.Data
@using SnabDrive.Web.Data.Entities
@using SnabDrive.Web.Domain
@using SnabDrive.Web.Services
@attribute [Authorize]
@inject IKonturService Kontur
@inject KonturSchedulerService Scheduler
@inject KonturSchedulerState SchedulerState
@implements IDisposable
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider
@inject SnabDrive.Web.Services.IRolePermissionService RolePerms

<div class="page">
    <PageHeader Title="Контур шаблоны" />

    @if (_denied)
    {
        <div class="alert alert-error">Нет доступа к «Контур шаблоны». Обратитесь к администратору.</div>
    }
    @if (_error is not null)
    {
        <div class="alert alert-error">@_error</div>
    }
    @if (_statusMessage is not null)
    {
        <div class="alert alert-info">@_statusMessage</div>
    }

    <div class="toolbar">
        <button class="btn btn-primary" disabled="@(_busy || _denied || SchedulerState.IsRunning)" @onclick="ExportNow"><Icon Name="download" /> Выгрузить шаблоны сейчас</button>
        <button class="btn" disabled="@_busy" @onclick="LoadAsync"><Icon Name="refresh" /> Обновить</button>
        <label class="chk">
            показать
            <select @bind="_pageSize" @bind:after="LoadAsync">
                @foreach (var n in PageSizes)
                {
                    <option value="@n">@n</option>
                }
            </select>
        </label>
        <div class="toolbar-spacer"></div>
        <button class="btn btn--danger" disabled="@(_selected.Count == 0 || _busy)" @onclick="DeleteSelectedAsync">Удалить (@_selected.Count)</button>
        <span class="muted">Записей: @(_rows?.Count ?? 0)</span>
    </div>

    <div class="page__section">
        <div class="grid-wrapper">
            <table class="registry-grid">
                <thead>
                    <tr class="registry-grid__head">
                        <th style="width:36px"><input type="checkbox" checked="@AllSelected" @onchange="ToggleAll" title="Выделить все" /></th>
                        <th class="registry-grid__index">#</th>
                        <th class='@HeadClass("Num")' title="Сортировать по «Номер»" @onclick='() => SortBy("Num")'>
                            <span class="registry-grid__head-text">Номер</span>
                            @if (_sortKey == "Num")
                            {
                                <span class="registry-grid__sort">@Arrow("Num")</span>
                            }
                        </th>
                        <th class='@HeadClass("Name")' title="Сортировать по «Наименование»" @onclick='() => SortBy("Name")'>
                            <span class="registry-grid__head-text">Наименование</span>
                            @if (_sortKey == "Name")
                            {
                                <span class="registry-grid__sort">@Arrow("Name")</span>
                            }
                        </th>
                        <th class='@HeadClass("Customer")' title="Сортировать по «Заказчик»" @onclick='() => SortBy("Customer")'>
                            <span class="registry-grid__head-text">Заказчик</span>
                            @if (_sortKey == "Customer")
                            {
                                <span class="registry-grid__sort">@Arrow("Customer")</span>
                            }
                        </th>
                        <th class='@HeadClass("NmcK")' title="Сортировать по «НМЦК»" @onclick='() => SortBy("NmcK")'>
                            <span class="registry-grid__head-text">НМЦК</span>
                            @if (_sortKey == "NmcK")
                            {
                                <span class="registry-grid__sort">@Arrow("NmcK")</span>
                            }
                        </th>
                        <th class='@HeadClass("Date")' title="Сортировать по «Дата торгов»" @onclick='() => SortBy("Date")'>
                            <span class="registry-grid__head-text">Дата торгов</span>
                            @if (_sortKey == "Date")
                            {
                                <span class="registry-grid__sort">@Arrow("Date")</span>
                            }
                        </th>
                        <th class='@HeadClass("AppEnd")' title="Сортировать по «Окончание приема заявок»" @onclick='() => SortBy("AppEnd")'>
                            <span class="registry-grid__head-text">Окончание приема заявок</span>
                            @if (_sortKey == "AppEnd")
                            {
                                <span class="registry-grid__sort">@Arrow("AppEnd")</span>
                            }
                        </th>
                        <th class='@HeadClass("Pub")' title="Сортировать по «Дата публикации»" @onclick='() => SortBy("Pub")'>
                            <span class="registry-grid__head-text">Дата публикации</span>
                            @if (_sortKey == "Pub")
                            {
                                <span class="registry-grid__sort">@Arrow("Pub")</span>
                            }
                        </th>
                        <th class='@HeadClass("Label")' title="Сортировать по «Метка»" @onclick='() => SortBy("Label")'>
                            <span class="registry-grid__head-text">Метка</span>
                            @if (_sortKey == "Label")
                            {
                                <span class="registry-grid__sort">@Arrow("Label")</span>
                            }
                        </th>
                        <th class='@HeadClass("Added")' title="Сортировать по «Добавлено»" @onclick='() => SortBy("Added")'>
                            <span class="registry-grid__head-text">Добавлено</span>
                            @if (_sortKey == "Added")
                            {
                                <span class="registry-grid__sort">@Arrow("Added")</span>
                            }
                        </th>
                        <th><span class="registry-grid__head-text">Действия</span></th>
                    </tr>
                    <tr class="registry-grid__filters">
                        <th></th>
                        <th></th>
                        <th><input class="filter-input" placeholder="фильтр" value='@GetFilter("Num")' @onchange='e => SetFilter("Num", e)' /></th>
                        <th><input class="filter-input" placeholder="фильтр" value='@GetFilter("Name")' @onchange='e => SetFilter("Name", e)' /></th>
                        <th><input class="filter-input" placeholder="фильтр" value='@GetFilter("Customer")' @onchange='e => SetFilter("Customer", e)' /></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th><input class="filter-input" placeholder="фильтр" value='@GetFilter("Label")' @onchange='e => SetFilter("Label", e)' /></th>
                        <th></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (_rows is null)
                    {
                        <tr><td colspan="12" class="registry-grid__empty">Загрузка…</td></tr>
                    }
                    else if (!_rows.Any())
                    {
                        <tr><td colspan="12" class="registry-grid__empty">Нет выгрузок шаблонов.</td></tr>
                    }
                    else
                    {
                        foreach (var (t, index) in Sorted().Select((x, n) => (x, n + 1)))
                        {
                            <tr>
                                <td class="registry-grid__cell"><input type="checkbox" checked="@_selected.Contains(t.Id)" @onchange="e => Toggle(t.Id, e.Value is bool b && b)" /></td>
                                <td class="registry-grid__index">@index</td>
                                <td class="registry-grid__cell">@t.PurchaseNumber</td>
                                <td class="registry-grid__cell">
                                    @if (!string.IsNullOrWhiteSpace(t.EisLink))
                                    {
                                        <a class="registry-grid__link" href="@t.EisLink" target="_blank" rel="noopener">@t.NameLink</a>
                                    }
                                    else
                                    {
                                        @t.NameLink
                                    }
                                </td>
                                <td class="registry-grid__cell">@t.Customer</td>
                                <td class="registry-grid__cell"><span class="money-cell">@MoneyFormat.Money(t.NMCK)</span></td>
                                <td class="registry-grid__cell">@(t.BiddingDate?.ToString("dd.MM.yyyy") ?? "—")</td>
                                <td class="registry-grid__cell">@(t.ApplicationEndDate?.ToString("dd.MM.yyyy HH:mm") ?? "—")</td>
                                <td class="registry-grid__cell">@(t.DateOfPlacement?.ToString("dd.MM.yyyy") ?? "—")</td>
                                <td class="registry-grid__cell">@(string.IsNullOrWhiteSpace(t.Label) ? "—" : t.Label)</td>
                                <td class="registry-grid__cell">@t.AddedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                <td class="registry-grid__cell">
                                    <button class="btn btn-link btn-sm btn--danger" @onclick="() => DeleteAsync(t)">Удалить</button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>


@code {
    private List<KonturTemplate>? _rows;
    private readonly HashSet<int> _selected = new();
    private int _pageSize = 50;
    private static readonly int[] PageSizes = { 50, 100, 200, 500 };
    private bool AllSelected => _rows is { Count: > 0 } && _selected.Count == _rows.Count;
    private ChangeActor _actor = new(string.Empty, "system");
    private bool _busy;
    private bool _schedulerHooked;
    private bool _wasRunning;
    private bool _denied;
    private string? _statusMessage;
    private string? _error;
    private string _sortKey = "Pub";
    private bool _sortDesc = true;
    private readonly Dictionary<string, string> _filters = new();

    protected override async Task OnInitializedAsync()
    {
        if (!_schedulerHooked)
        {
            _schedulerHooked = true;
            _wasRunning = SchedulerState.IsRunning;
            SchedulerState.Changed += OnSchedulerChanged;
        }

        try
        {
            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            var uid = state.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
            _actor = new ChangeActor(uid, state.User.Identity?.Name ?? "system");
            var feats = await RolePerms.GetEffectiveFeaturesAsync(uid);
            _denied = !(feats.TryGetValue(SnabDrive.Web.Services.AppFeatures.Kontur, out var kf) && kf);
            if (!_denied)
            {
                await LoadAsync();
            }
        }
        catch
        {
            // Пререндер (F5) может не иметь контекста — цепь повторит инициализацию.
        }
    }

    private async Task LoadAsync()
    {
        _busy = true;
        try
        {
            _rows = (await Kontur.GetTemplatesAsync(_pageSize)).ToList();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private void ExportNow()
    {
        _busy = true;
        _error = null;
        _statusMessage = null;
        _wasRunning = true;
        // Запуск в фоне — блокировка (оверлей) появляется сразу, поток UI не блокируется.
        // Снятие блокировки и обновление списка делает OnSchedulerChanged.
        _ = Task.Run(async () =>
        {
            try
            {
                await Scheduler.RunAsync("вручную (Контур шаблоны)", ExportMode.Templates);
            }
            catch (Exception ex)
            {
                await InvokeAsync(() =>
                {
                    _busy = false;
                    _error = ErrorText.Describe(ex);
                });
            }
        });
    }

    /// <summary>
    /// Выгрузка завершилась — снимаем блокировку и перечитываем список. Сработает
    /// и тогда, когда выгрузку запустило расписание или другой пользователь.
    /// </summary>
    private void OnSchedulerChanged()
    {
        var running = SchedulerState.IsRunning;
        var finished = _wasRunning && !running;
        _wasRunning = running;

        _ = InvokeAsync(async () =>
        {
            if (finished)
            {
                _statusMessage = SchedulerState.LastMessage;
                await LoadAsync();
            }

            StateHasChanged();
        });
    }

    public void Dispose()
    {
        if (_schedulerHooked)
        {
            SchedulerState.Changed -= OnSchedulerChanged;
            _schedulerHooked = false;
        }
    }

    private async Task DeleteAsync(KonturTemplate t)
    {
        var ok = await JS.InvokeAsync<bool>("confirm", $"Удалить запись «{t.NameLink}»?");
        if (!ok) return;
        _error = null;
        var result = await Kontur.DeleteTemplateAsync(t.Id, new ChangeActor("director", "Директор"));
        if (!result.Success) { _error = result.Error; return; }
        await LoadAsync();
    }

    private void ToggleAll(ChangeEventArgs e)
    {
        var on = e.Value is bool b && b;
        _selected.Clear();
        if (on && _rows is not null)
        {
            foreach (var t in _rows) { _selected.Add(t.Id); }
        }
    }

    private void Toggle(int id, bool on)
    {
        if (on) { _selected.Add(id); }
        else { _selected.Remove(id); }
    }

    private async Task DeleteSelectedAsync()
    {
        if (_selected.Count == 0) return;
        var ok = await JS.InvokeAsync<bool>("confirm",
            $"Удалить выбранные шаблоны ({_selected.Count}) из базы безвозвратно?");
        if (!ok) return;
        var result = await Kontur.DeleteTemplatesAsync(_selected, _actor);
        _statusMessage = result.Success ? $"Удалено шаблонов: {result.Value}." : (result.Error ?? "Ошибка удаления");
        _selected.Clear();
        await LoadAsync();
    }

    private void SortBy(string key)
    {
        if (_sortKey == key) { _sortDesc = !_sortDesc; }
        else { _sortKey = key; _sortDesc = false; }
    }

    /// <summary>Как в реестре: стрелка показывается только у отсортированной колонки.</summary>
    private string Arrow(string key) => _sortKey == key ? (_sortDesc ? "▼" : "▲") : string.Empty;

    private string HeadClass(string key) => _sortKey == key ? "is-sorted" : string.Empty;

    private string GetFilter(string key) => _filters.TryGetValue(key, out var v) ? v : string.Empty;

    private void SetFilter(string key, ChangeEventArgs e)
    {
        var v = e.Value?.ToString() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(v)) _filters.Remove(key); else _filters[key] = v;
    }

    private List<KonturTemplate> Filtered()
    {
        var rows = _rows ?? new List<KonturTemplate>();
        foreach (var f in _filters)
        {
            rows = rows.Where(t => f.Key switch
            {
                "Num" => Contains(t.PurchaseNumber, f.Value),
                "Name" => Contains(t.NameLink, f.Value),
                "Customer" => Contains(t.Customer, f.Value),
                "Label" => Contains(t.Label ?? string.Empty, f.Value),
                _ => true
            }).ToList();
        }
        return rows;
    }

    private List<KonturTemplate> Sorted()
    {
        var rows = Filtered();
        IEnumerable<KonturTemplate> ordered = _sortKey switch
        {
            "Num" => Ord(t => t.PurchaseNumber),
            "Name" => Ord(t => t.NameLink),
            "Customer" => Ord(t => t.Customer),
            "NmcK" => Ord(t => t.NMCK),
            "Date" => Ord(t => t.BiddingDate),
            "AppEnd" => Ord(t => t.ApplicationEndDate),
            "Pub" => Ord(t => t.DateOfPlacement),
            "Label" => Ord(t => t.Label),
            "Added" => Ord(t => t.AddedAt),
            _ => rows
        };
        return (_sortDesc ? ordered.Reverse() : ordered).ToList();
    }

    private IEnumerable<KonturTemplate> Ord<T>(Func<KonturTemplate, T> key) => Filtered().OrderBy(key);

    private static bool Contains(string value, string filter) =>
        value.Contains(filter, StringComparison.OrdinalIgnoreCase);
}
