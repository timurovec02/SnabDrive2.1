@page "/kontur"
@attribute [Authorize]
@inject IKonturService Kontur
@inject IToastService Toasts
@inject KonturSchedulerService Scheduler
@inject KonturSchedulerState SchedulerState

<PageTitle>Избранное Контур — SnabDrive</PageTitle>

<div class="page">
    <div class="page__header">
        <div>
            <h1>Избранное Контур</h1>
            <p class="page__hint">
                Выгрузка из Контур.Закупки. Нажмите «Выгрузить сейчас», отберите нужные
                закупки и перенесите их в реестр.
            </p>
        </div>
    </div>

    @if (_denied)
    {
        <div class="alert alert--warn">У вас нет доступа к выгрузке из Контур. Обратитесь к администратору.</div>
    }
    else
    {
        <div class="toolbar">
            <button class="btn btn--primary" disabled="@_busy" @onclick="ExportNowAsync">Выгрузить сейчас</button>
            <button class="btn" @onclick="LoadAsync">Обновить</button>
            <label class="chk">
                <input type="checkbox" @bind="_onlyNew" @bind:after="LoadAsync" /> только новые
            </label>
            <div class="toolbar__spacer"></div>
            <button class="btn btn--primary" disabled="@(_selected.Count == 0 || _busy)" @onclick="ImportSelectedAsync">
                Перенести в реестр (@_selected.Count)
            </button>
            <button class="btn" disabled="@(_selected.Count == 0 || _busy)" @onclick="RejectSelectedAsync">Отклонить</button>
        </div>

        @if (_message is not null)
        {
            <div class="alert @(_messageOk ? "alert--ok" : "alert--warn")">@_message</div>
        }

        <div class="table-wrap">
            <table class="registry-grid registry-grid--wide">
                <thead>
                    <tr>
                        <th style="width:36px"><input type="checkbox" checked="@AllSelected" @onchange="ToggleAll" title="Выделить все" /></th>
                        <th class="th-sort" @onclick='() => SortBy("PurchaseNumber")'>Номер @Arrow("PurchaseNumber")</th>
                        <th>Наименование</th>
                        <th>Заказчик</th>
                        <th class="th-sort" @onclick='() => SortBy("NMCK")'>НМЦК @Arrow("NMCK")</th>
                        <th class="th-sort" @onclick='() => SortBy("BiddingDate")'>Дата торгов @Arrow("BiddingDate")</th>
                        <th>Место поставки</th>
                        <th>Победитель</th>
                        <th class="th-sort" @onclick='() => SortBy("ResultPrice")'>Итог @Arrow("ResultPrice")</th>
                        <th class="th-sort" @onclick='() => SortBy("Label")'>Статус @Arrow("Label")</th>
                        <th>Ссылка на ЕИС</th>
                        <th>Обработка</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_favorites.Count == 0)
                    {
                        <tr><td colspan="12" class="registry-grid__empty">Нет строк. Нажмите «Выгрузить сейчас».</td></tr>
                    }
                    else
                    {
                        @foreach (var f in Sorted())
                        {
                            <tr class="@(f.Status == KonturFavoriteStatus.Imported ? "is-finished" : "")">
                                <td>
                                    @if (f.Status == KonturFavoriteStatus.New)
                                    {
                                        <input type="checkbox" checked="@_selected.Contains(f.Id)"
                                               @onchange="e => Toggle(f.Id, e.Value is bool b && b)" />
                                    }
                                </td>
                                <td>@f.PurchaseNumber</td>
                                <td>@f.NameLink</td>
                                <td>@f.Customer</td>
                                <td class="money-cell">@f.NMCK.ToString("# ##0.00")</td>
                                <td>@(f.BiddingDate?.ToString("dd.MM.yyyy HH:mm") ?? "—")</td>
                                <td>@f.PlaceOfDelivery</td>
                                <td>@f.Winner</td>
                                <td class="money-cell">@f.ResultPrice.ToString("# ##0.00")</td>
                                <td>@f.Label</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(f.EisLink))
                                    {
                                        <a class="registry-grid__link" href="@f.EisLink" target="_blank" rel="noopener noreferrer">ЕИС</a>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>
                                <td>
                                    @switch (f.Status)
                                    {
                                        case KonturFavoriteStatus.Imported:
                                            <span class="badge badge--ok">в реестре @(f.RegeditId is null ? "" : $"#{f.RegeditId}")</span>
                                            break;
                                        case KonturFavoriteStatus.Rejected:
                                            <span class="badge">отклонено</span>
                                            break;
                                        default:
                                            <span class="badge badge--info">новое</span>
                                            break;
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private List<KonturFavorite> _favorites = new();
    private readonly HashSet<int> _selected = new();
    private ChangeActor _actor = new(string.Empty, "system");
    private bool _denied;
    private bool _onlyNew = true;
    private bool _busy;
    private string? _message;
    private bool _messageOk;
    private string _sortKey = "AddedAt";
    private bool _sortDesc = true;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var state = await AuthState;
            var user = state.User;
            _denied = !KonturClaim.CanUse(user);
            _actor = new ChangeActor(user.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty,
                                     user.Identity?.Name ?? "system");
        }

        if (!_denied)
        {
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        _favorites = (await Kontur.GetFavoritesAsync(_onlyNew)).ToList();
        _selected.Clear();
    }

    private bool AllSelected =>
        _favorites.Any(f => f.Status == KonturFavoriteStatus.New) &&
        _favorites.Where(f => f.Status == KonturFavoriteStatus.New).All(f => _selected.Contains(f.Id));

    private void ToggleAll(ChangeEventArgs e)
    {
        var on = e.Value is bool b && b;
        _selected.Clear();
        if (on)
        {
            foreach (var id in _favorites.Where(f => f.Status == KonturFavoriteStatus.New).Select(f => f.Id))
            {
                _selected.Add(id);
            }
        }
    }

    private void Toggle(int id, bool on)
    {
        if (on)
        {
            _selected.Add(id);
        }
        else
        {
            _selected.Remove(id);
        }
    }

    private void SortBy(string key)
    {
        if (_sortKey == key)
        {
            _sortDesc = !_sortDesc;
        }
        else
        {
            _sortKey = key;
            _sortDesc = false;
        }
    }

    private string Arrow(string key) => _sortKey == key ? (_sortDesc ? "▼" : "▲") : "";

    private IEnumerable<KonturFavorite> Sorted() => _sortKey switch
    {
        "PurchaseNumber" => Ord(f => f.PurchaseNumber),
        "NMCK" => Ord(f => f.NMCK),
        "BiddingDate" => Ord(f => f.BiddingDate),
        "ResultPrice" => Ord(f => f.ResultPrice),
        "Label" => Ord(f => f.Label),
        _ => Ord(f => f.AddedAt)
    };

    private IEnumerable<KonturFavorite> Ord<T>(Func<KonturFavorite, T> key) =>
        _sortDesc ? _favorites.OrderByDescending(key) : _favorites.OrderBy(key);

    private async Task ExportNowAsync()
    {
        _busy = true;
        _message = null;
        await Scheduler.RunAsync("вручную со страницы Контур");
        _messageOk = SchedulerState.LastSuccess;
        _message = SchedulerState.LastMessage;
        await LoadAsync();
        _busy = false;
    }

    private async Task ImportSelectedAsync()
    {
        _busy = true;
        _message = null;
        var result = await Kontur.ImportToRegistryAsync(_selected, _actor);
        _messageOk = result.Success;
        _message = result.Success ? $"Перенесено в реестр: {result.Value}." : result.Error;
        await LoadAsync();
        _busy = false;
    }

    private async Task RejectSelectedAsync()
    {
        _busy = true;
        await Kontur.SetStatusAsync(_selected, KonturFavoriteStatus.Rejected);
        await LoadAsync();
        _busy = false;
    }
}
