@page "/login"
@attribute [AllowAnonymous]
@layout EmptyLayout
@inject NavigationManager Navigation

<PageTitle>Вход — Снабдрайв</PageTitle>

<div class="login-page">
    <div class="login-page__brand">
        <img src="favicon.png?v=4" alt="" width="36" height="36" />
        <span class="login-page__brand-name">Снабдрайв</span>
    </div>

    <div class="login-shell">
        <aside class="login-hero">
                            <div class="login-hero__mark">
                    <img src="favicon.png?v=4" alt="" />
                </div>
            <div class="login-hero__copy">
                <p class="login-hero__eyebrow">СНАБДРАЙВ · РЕЕСТР ЗАКУПОК</p>
                <h1 class="login-hero__title">Ваше снабжение.<br />В одном месте.</h1>
                <p class="login-hero__note"><span class="login-hero__dot"></span> Безопасное рабочее пространство</p>
            </div>
        </aside>

        <main class="login-form-side">
            <form class="login-card" method="post" action="/account/login">
                <AntiforgeryToken />
                <input type="hidden" name="returnUrl" value="@_returnUrl" />

                <p class="login-card__kicker">С ВОЗВРАЩЕНИЕМ</p>
                <h2 class="login-card__title">Войти в систему</h2>
                <p class="login-card__subtitle">Введите данные учётной записи, чтобы продолжить работу с реестром закупок.</p>

                @if (!string.IsNullOrEmpty(_errorText))
                {
                    <div class="form-error">@_errorText</div>
                }

                @if (!string.IsNullOrEmpty(_noticeText))
                {
                    <div class="form-notice">@_noticeText</div>
                }

                <label class="login-card__label">
                    Логин
                    <div class="login-field">
                        <Icon Name="users" Class="login-field__icon" />
                        <input class="input" name="login" autocomplete="username" autofocus required />
                    </div>
                </label>

                <label class="login-card__label">
                    Пароль
                    <div class="login-field" style="position:relative">
                        <Icon Name="lock" Class="login-field__icon" />
                        <input class="input" name="password" type="password" autocomplete="current-password" required />
                        <button type="button" class="pw-eye" tabindex="-1" title="Показать пароль"
                                style="position:absolute;right:8px;top:50%%;transform:translateY(-50%%);border:0;background:transparent;cursor:pointer;padding:6px;color:#64748b;display:inline-flex"
                                onclick="var i=this.parentNode.querySelector('input');var s=i.type==='password';i.type=s?'text':'password';this.title=s?'Скрыть пароль':'Показать пароль';this.querySelector('.pw-eye__on').hidden=!s;this.querySelector('.pw-eye__off').hidden=s;">
                            <span class="pw-eye__on"><Icon Name="eye" /></span>
                            <span class="pw-eye__off" hidden><Icon Name="eyeOff" /></span>
                        </button>
                    </div>
                </label>

                <label class="checkbox-label">
                    <input type="checkbox" name="rememberMe" value="true" />
                    Запомнить меня
                </label>

                <button type="submit" class="btn btn--primary btn--block login-card__submit">
                    <span>Войти в систему</span>
                    <Icon Name="chevronRight" />
                </button>

                <p class="login-card__hint">
                    <Icon Name="lock" Class="login-card__hint-icon" />
                    Соединение защищено. Никому не сообщайте свой пароль. После 5 неудачных попыток вход блокируется на 10 минут.
                </p>
            </form>
        </main>
    </div>

    <footer class="login-footer">Снабдрайв · защищённое рабочее пространство</footer>
</div>

@code {

    private string _returnUrl = "/";
    private string? _errorText;
    private string? _noticeText;

    protected override void OnInitialized()
    {
        var uri = new Uri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("returnUrl", out var returnUrl))
        {
            var candidate = returnUrl.ToString();
            if (candidate.StartsWith('/') && !candidate.StartsWith("//", StringComparison.Ordinal))
            {
                _returnUrl = candidate;
            }
        }

        if (query.TryGetValue("loggedout", out _))
        {
            _noticeText = "Вы вышли из системы.";
        }

        if (query.TryGetValue("error", out var error))
        {
            _errorText = error.ToString() switch
            {
                "invalid" => "Неверный логин или пароль.",
                "locked" => "Слишком много неудачных попыток. Вход временно заблокирован.",
                "blocked" => "Учётная запись заблокирована. Обратитесь к администратору.",
                "empty" => "Введите логин и пароль.",
                "token" => "Сессия устарела. Попробуйте ещё раз.",
                _ => "Не удалось выполнить вход."
            };
        }
    }
}
