@page "/error"
@attribute [AllowAnonymous]
@layout EmptyLayout

<PageTitle>Ошибка — Снабдрайв</PageTitle>

<div class="login-page">
    <div class="login-card">
        <div class="login-card__emoji" aria-hidden="true">⚠️</div>
        <h1 class="login-card__title">Что-то пошло не так</h1>
        <p>Произошла ошибка при обработке запроса. Попробуйте обновить страницу.</p>
        <a class="btn btn--primary btn--block" href="/">На главную</a>
    </div>
</div>
