@page "/users"
@attribute [Authorize(Policy = AppPolicies.ManageSystem)]
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@inject IAuditService Audit
@inject IRegistryNotifier Notifier
@inject IPresenceService Presence
@inject AuthenticationStateProvider AuthStateProvider
@inject IToastService Toasts
@inject IRegistryEventBus EventBus
@inject IColumnAccessService ColumnAccess
@inject BitrixNotifier Bitrix
@inject SnabDrive.Web.Services.IPasswordPolicyService Policy
@implements IDisposable

<PageTitle>Пользователи — Снабдрайв</PageTitle>

<div class="page page--fill">
    <PageHeader IconName="users"
                Title="Пользователи и роли"
                Subtitle="Учётные записи, роли и личные права: доступ к вкладкам, колонкам реестра, выгрузке из Контур и переводу закупок между стадиями.">
        <Actions>
            <button type="button" class="btn btn--primary" @onclick="StartCreate">＋ Добавить пользователя</button>
            <button type="button" class="btn" @onclick="OpenPolicyAsync" title="Требования к паролям">Политика паролей</button>
            <button type="button" class="btn btn--ghost" @onclick="LoadAsync" title="Обновить">⟳</button>
        </Actions>
    </PageHeader>

    <div class="page__section">
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Логин</th>
                        <th>Отображаемое имя</th>
                        <th>Email</th>
                        <th>Роль</th>
                        <th>Статус</th>
                        <th>Последний вход</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in _users)
                    {
                        <tr class="@(user.IsOnline ? "is-online" : null)">
                            <td>@user.UserName</td>
                            <td>@user.DisplayName</td>
                            <td>@user.Email</td>
                            <td>@AppRoles.DisplayName(user.Role)</td>
                            <td>
                                @if (user.IsBlocked)
                                {
                                    <span class="badge badge--danger">заблокирован</span>
                                }
                                else if (user.IsOnline)
                                {
                                    <span class="badge badge--success">онлайн</span>
                                }
                                else
                                {
                                    <span class="badge">офлайн</span>
                                }
                            </td>
                            <td>@(user.LastLoginUtc?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "—")</td>
                            <td class="row-actions">
                                <button type="button" class="btn btn--small" @onclick="() => StartEdit(user)">Изменить</button>
                                <button type="button" class="btn btn--small" @onclick="() => OpenColumns(user)">Колонки</button>
                                <button type="button" class="btn btn--small" @onclick="() => TestNotifyAsync(user)"
                                        title="Отправить тестовое уведомление в Битрикс24">Проверить</button>
                                <button type="button" class="btn btn--small btn--danger" @onclick="() => AskDelete(user)">Удалить</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (_showForm)
{
    <div class="modal-backdrop">
        <div class="modal" @onclick:stopPropagation="true">
            <div class="modal__header">
                <h2>@(_editingId is null ? "Новый пользователь" : $"Пользователь {_model.UserName}")</h2>
                <button type="button" class="modal__close" @onclick="CloseForm">×</button>
            </div>
            <div class="modal__body">
                <div class="form-grid">
                    <div class="form-field">
                        <label>Логин *</label>
                        <input class="input" @bind="_model.UserName" disabled="@(_editingId is not null)" />
                    </div>
                    <div class="form-field">
                        <label>Отображаемое имя</label>
                        <input class="input" @bind="_model.DisplayName" />
                    </div>
                    <div class="form-field">
                        <label>Email</label>
                        <input class="input" @bind="_model.Email" />
                    </div>
                    <div class="form-field">
                        <label>ID сотрудника в Битрикс24</label>
                        <input class="input" @bind="_model.BitrixUserId" placeholder="напр. 1"
                               title="Числовой ID сотрудника Битрикс24 — для личных уведомлений (im.notify TO=...)" />
                    </div>
                    <div class="form-field">
                        <label>@(_editingId is null ? "Пароль *" : "Новый пароль (пусто — не менять)")</label>
                        <input class="input" type="password" @bind="_model.Password" autocomplete="new-password"
                               title="Требования задаёт администратор: «Политика паролей»" />
                        <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:6px">
                            <button type="button" class="btn btn--small" @onclick="GeneratePassword"
                                    title="Подобрать пароль, подходящий под политику">Сгенерировать</button>
                            <label class="checkbox-label"
                                   title="Администратор выдаёт временный пароль: пользователь сменит его при первом входе">
                                <input type="checkbox" @bind="_model.MustChangePassword" /> Смена при первом входе
                            </label>
                        </div>
                        <div style="font-size:11.5px;color:#667085;margin-top:4px">
                            @_policyHint
                        </div>
                    </div>
                    <div class="form-field form-field--checkbox">
                        <label class="checkbox-label" style="display:flex;gap:8px;align-items:center">
                            Роль:
                            <select class="input" @bind="_model.Role" style="width:auto">
                                @foreach (var role in AppRoles.All)
                                {
                                    <option value="@role">@AppRoles.DisplayName(role)</option>
                                }
                            </select>
                        </label>
                        <label class="checkbox-label">
                            <input type="checkbox" @bind="_model.IsBlocked" /> Заблокирован
                        </label>
                        <label class="checkbox-label">
                            <input type="checkbox" @bind="_model.KonturEnabled" /> Доступ к Контур
                        </label>
                        <label class="checkbox-label">
                            <input type="checkbox" @bind="_model.SchedulerEnabled" /> Доступ к планировщику
                        </label>
                        <label class="checkbox-label">
                            <input type="checkbox" @bind="_model.StageChangeEnabled" /> Менять стадию закупок
                        </label>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(_formError))
                {
                    <div class="form-error">@_formError</div>
                }
            </div>
            <div class="modal__footer">
                <button type="button" class="btn btn--primary" @onclick="SaveAsync" disabled="@_busy">Сохранить</button>
                <button type="button" class="btn" @onclick="CloseForm">Отмена</button>
            </div>
        </div>
    </div>
}

@if (_showColumns && _columnsUser is not null)
{
    <div class="modal-backdrop">
        <div class="modal" @onclick:stopPropagation="true">
            <div class="modal__header">
                <h2>Доступ к колонкам: @_columnsUser.UserName</h2>
                <button type="button" class="modal__close" @onclick="CloseColumns">×</button>
            </div>
            <div class="modal__body">
                <div class="form-field form-field--checkbox" style="margin-bottom:12px">
                    <label class="checkbox-label">
                        <input type="radio" name="colmode" checked="@(_columnMode == ColumnAccessMode.AllColumns)"
                               @onchange="() => _columnMode = ColumnAccessMode.AllColumns" />
                        Все колонки
                    </label>
                    <label class="checkbox-label">
                        <input type="radio" name="colmode" checked="@(_columnMode == ColumnAccessMode.CustomColumns)"
                               @onchange="() => _columnMode = ColumnAccessMode.CustomColumns" />
                        Только выбранные
                    </label>
                </div>

                <p class="page__hint">
                    «Просмотр» — значение видно в таблице и в форме. «Правка» — поле можно изменить.
                    Без права просмотра значение не уходит в браузер вовсе.
                </p>

                <table class="data-table data-table--compact column-matrix">
                    <thead>
                        <tr>
                            <th>Колонка</th>
                            <th style="width:90px">Просмотр</th>
                            <th style="width:90px">Правка</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in _columnRows)
                        {
                            <tr class="@(_columnMode == ColumnAccessMode.AllColumns ? "is-muted" : null)">
                                <td>@row.Title</td>
                                <td><input type="checkbox" @bind="row.View" disabled="@(_columnMode == ColumnAccessMode.AllColumns)" /></td>
                                <td><input type="checkbox" @bind="row.Edit" disabled="@(_columnMode == ColumnAccessMode.AllColumns || !row.View)" /></td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (!string.IsNullOrEmpty(_columnError))
                {
                    <div class="form-error">@_columnError</div>
                }
            </div>
            <div class="modal__footer">
                <button type="button" class="btn btn--primary" @onclick="SaveColumnsAsync" disabled="@_busy">Сохранить</button>
                <button type="button" class="btn" @onclick="CloseColumns">Отмена</button>
            </div>
        </div>
    </div>
}

@if (_confirm is not null)
{
    <ConfirmDialog Title="@_confirm.Title"
                   Message="@_confirm.Message"
                   ConfirmText="@_confirm.ConfirmText"
                   OnConfirm="@_confirm.OnConfirm"
                   OnCancel="@(() => _confirm = null)" />
}

@if (_showPolicy)
{
    <div class="modal-backdrop">
        <div class="modal" @onclick:stopPropagation="true">
            <div class="modal__header">
                <h2>Политика паролей</h2>
                <button type="button" class="modal__close" @onclick="() => _showPolicy = false">×</button>
            </div>
            <div class="modal__body">
                <div class="form-grid">
                    <div class="form-field">
                        <label>Минимальная длина</label>
                        <input class="input" type="number" min="6" max="64" @bind="_policyModel.MinLength" />
                    </div>
                    <div class="form-field">
                        <label>Минимум различных символов</label>
                        <input class="input" type="number" min="1" max="10" @bind="_policyModel.MinUniqueChars" />
                    </div>
                    <div class="form-field form-field--checkbox">
                        <label class="checkbox-label"><input type="checkbox" @bind="_policyModel.RequireUppercase" /> Заглавная буква</label>
                        <label class="checkbox-label"><input type="checkbox" @bind="_policyModel.RequireLowercase" /> Строчная буква</label>
                        <label class="checkbox-label"><input type="checkbox" @bind="_policyModel.RequireDigit" /> Цифра</label>
                        <label class="checkbox-label"><input type="checkbox" @bind="_policyModel.RequireSpecial" /> Спецсимвол</label>
                    </div>
                </div>
                <div style="font-size:11.5px;color:#667085;margin-top:8px">
                    Требования действуют при создании пользователя, смене и сбросе пароля.
                </div>
                @if (!string.IsNullOrEmpty(_policyError))
                {
                    <div class="form-error">@_policyError</div>
                }
            </div>
            <div class="modal__footer">
                <button type="button" class="btn btn--primary" @onclick="SavePolicyAsync" disabled="@_busy">Сохранить</button>
                <button type="button" class="btn" @onclick="() => _showPolicy = false">Отмена</button>
            </div>
        </div>
    </div>
}

@code {
    private sealed record UserRow(string Id, string UserName, string? DisplayName, string? Email,
                                  bool IsAdmin, bool IsBlocked, bool IsOnline, DateTime? LastLoginUtc, bool KonturEnabled, bool SchedulerEnabled, bool StageChangeEnabled, string Role, string? BitrixUserId, bool MustChangePassword);

    private sealed class UserModel
    {
        public string UserName { get; set; } = string.Empty;
        public string? DisplayName { get; set; }
        public string? Email { get; set; }
        public string? Password { get; set; }
        public bool IsAdmin { get; set; }
        public string Role { get; set; } = SnabDrive.Web.Services.AppRoles.Operator;
        public bool IsBlocked { get; set; }
        public bool KonturEnabled { get; set; }
        public bool SchedulerEnabled { get; set; }
        public bool StageChangeEnabled { get; set; }
        public string? BitrixUserId { get; set; }
        public bool MustChangePassword { get; set; } = true;
    }

    private List<UserRow> _users = new();
    private UserModel _model = new();
    private string? _editingId;
    private string? _formError;
    private bool _showForm;
    private bool _busy;
    private string _currentUserId = string.Empty;
    private ConfirmRequest? _confirm;
    private bool _showPolicy;
    private string? _policyError;
    private SnabDrive.Web.Data.Entities.PasswordPolicy _policyModel = new();
    private string _policyHint = "требования: не менее 10 символов, заглавная и строчная буквы, цифра, спецсимвол";

    protected override async Task OnInitializedAsync()
    {
        // Список онлайна меняется при каждом подключении/отключении — обновляем таблицу.
        EventBus.PresenceChanged += OnPresenceChanged;

        try
        {
            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            _currentUserId = state.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
            await LoadAsync();
            await LoadPolicyAsync();
        }
        catch
        {
            // Пререндер (F5) может не иметь контекста — цепь повторит инициализацию.
        }
    }

    private void OnPresenceChanged(IReadOnlyList<OnlineUser> online)
    {
        _ = InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        });
    }

    private async Task LoadAsync()
    {
        var online = Presence.GetOnline().Select(u => u.UserId).ToHashSet(StringComparer.Ordinal);
        var users = UserManager.Users.OrderBy(u => u.UserName).ToList();
        var rows = new List<UserRow>(users.Count);

        foreach (var user in users)
        {
            var role = await GetRole(user);
            rows.Add(new UserRow(
                user.Id,
                user.UserName ?? string.Empty,
                user.DisplayName,
                user.Email,
                role == AppRoles.Admin,
                user.IsBlocked,
                online.Contains(user.Id),
                user.LastLoginUtc,
                user.KonturEnabled,
                user.SchedulerEnabled,
                user.StageChangeEnabled,
                role,
                user.BitrixUserId,
                user.MustChangePassword));
        }

        _users = rows;
    }

    private async Task LoadPolicyAsync()
    {
        try
        {
            _policyModel = await Policy.GetAsync();
            _policyHint = "требования: " + Policy.Describe(_policyModel);
        }
        catch
        {
            // БД недоступна — остаются значения по умолчанию.
        }
    }

    private async Task OpenPolicyAsync()
    {
        _policyError = null;
        await LoadPolicyAsync();
        _showPolicy = true;
    }

    private async Task SavePolicyAsync()
    {
        _busy = true;
        _policyError = null;

        try
        {
            var actor = _currentUserId.Length > 0 ? _currentUserId : "admin";
            await Policy.SaveAsync(_policyModel, actor);
            await Audit.WriteAsync(AuditAction.Updated, "PasswordPolicy", 1,
                new ChangeActor(_currentUserId, actor), summary: "Изменена политика паролей");
            _showPolicy = false;
            await LoadPolicyAsync();
            Toasts.Show("Политика паролей сохранена", ToastKind.Success);
        }
        catch (Exception ex)
        {
            _policyError = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>Подбирает пароль, подходящий под текущую политику.</summary>
    private void GeneratePassword()
    {
        const string Uppers = "ABCDEFGHJKLMNPQRSTUVWXYZ";
        const string Lowers = "abcdefghijkmnpqrstuvwxyz";
        const string Digits = "23456789";
        const string Specials = "!@#$%&*?+-=";

        var chars = new List<char>();
        if (_policyModel.RequireUppercase)
        {
            chars.Add(Pick(Uppers));
        }

        if (_policyModel.RequireLowercase)
        {
            chars.Add(Pick(Lowers));
        }

        if (_policyModel.RequireDigit)
        {
            chars.Add(Pick(Digits));
        }

        if (_policyModel.RequireSpecial)
        {
            chars.Add(Pick(Specials));
        }

        var all = Uppers + Lowers + Digits + Specials;
        var length = Math.Max(_policyModel.MinLength, chars.Count);
        while (chars.Count < length)
        {
            chars.Add(Pick(all));
        }

        // Перемешиваем: обязательные символы не должны идти подряд.
        for (var i = chars.Count - 1; i > 0; i--)
        {
            var j = System.Security.Cryptography.RandomNumberGenerator.GetInt32(i + 1);
            (chars[i], chars[j]) = (chars[j], chars[i]);
        }

        _model.Password = new string(chars.ToArray());
    }

    private static char Pick(string source) =>
        source[System.Security.Cryptography.RandomNumberGenerator.GetInt32(source.Length)];

    private async Task<string> GetRole(SnabDrive.Web.Data.ApplicationUser user)
    {
        foreach (var role in AppRoles.All)
        {
            if (await UserManager.IsInRoleAsync(user, role))
            {
                return role;
            }
        }

        return AppRoles.Operator;
    }

    private void StartCreate()
    {
        _editingId = null;
        _model = new UserModel();
        _formError = null;
        _showForm = true;
    }

    private void StartEdit(UserRow user)
    {
        _editingId = user.Id;
        _model = new UserModel
        {
            UserName = user.UserName,
            DisplayName = user.DisplayName,
            Email = user.Email,
            IsAdmin = user.IsAdmin,
            Role = user.Role,
            IsBlocked = user.IsBlocked,
            KonturEnabled = user.KonturEnabled,
            SchedulerEnabled = user.SchedulerEnabled,
            StageChangeEnabled = user.StageChangeEnabled,
            BitrixUserId = user.BitrixUserId,
            MustChangePassword = user.MustChangePassword
        };
        _formError = null;
        _showForm = true;
    }

    private void CloseForm()
    {
        _showForm = false;
        _editingId = null;
        _formError = null;
        _model = new UserModel();
    }

    private async Task SaveAsync()
    {
        _busy = true;
        _formError = null;

        try
        {
            if (_editingId is null)
            {
                await CreateAsync();
            }
            else
            {
                await UpdateAsync();
            }
        }
        catch (Exception ex)
        {
            _formError = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(_model.UserName) || string.IsNullOrWhiteSpace(_model.Password))
        {
            _formError = "Укажите логин и пароль";
            return;
        }

        if (await UserManager.FindByNameAsync(_model.UserName.Trim()) is not null)
        {
            _formError = $"Пользователь «{_model.UserName}» уже существует";
            return;
        }

        var user = new ApplicationUser
        {
            UserName = _model.UserName.Trim(),
            DisplayName = _model.DisplayName,
            Email = string.IsNullOrWhiteSpace(_model.Email) ? null : _model.Email,
            EmailConfirmed = !string.IsNullOrWhiteSpace(_model.Email),
            IsBlocked = _model.IsBlocked,
            KonturEnabled = _model.KonturEnabled,
            SchedulerEnabled = _model.SchedulerEnabled,
            StageChangeEnabled = _model.StageChangeEnabled,
            BitrixUserId = string.IsNullOrWhiteSpace(_model.BitrixUserId) ? null : _model.BitrixUserId.Trim(),
            MustChangePassword = _model.MustChangePassword
        };

        var created = await UserManager.CreateAsync(user, _model.Password);
        if (!created.Succeeded)
        {
            _formError = string.Join("; ", created.Errors.Select(e => e.Description));
            return;
        }

        await UserManager.AddToRoleAsync(user, _model.Role);
        await WriteAuditAsync("Создан пользователь «" + user.UserName + "»");

        Toasts.Show("Пользователь создан", ToastKind.Success);
        CloseForm();
        await LoadAsync();
    }

    private async Task UpdateAsync()
    {
        var user = await UserManager.FindByIdAsync(_editingId!);
        if (user is null)
        {
            _formError = "Пользователь не найден";
            return;
        }

        user.DisplayName = _model.DisplayName;
        user.IsBlocked = _model.IsBlocked;
        user.KonturEnabled = _model.KonturEnabled;
        user.SchedulerEnabled = _model.SchedulerEnabled;
        user.StageChangeEnabled = _model.StageChangeEnabled;
        user.BitrixUserId = string.IsNullOrWhiteSpace(_model.BitrixUserId) ? null : _model.BitrixUserId.Trim();
        user.MustChangePassword = _model.MustChangePassword;

        if (!string.IsNullOrWhiteSpace(_model.Email))
        {
            user.Email = _model.Email;
            user.EmailConfirmed = true;
        }

        if (!string.IsNullOrWhiteSpace(_model.Password))
        {
            var token = await UserManager.GeneratePasswordResetTokenAsync(user);
            var reset = await UserManager.ResetPasswordAsync(user, token, _model.Password);
            if (!reset.Succeeded)
            {
                _formError = string.Join("; ", reset.Errors.Select(e => e.Description));
                return;
            }
        }

        var updated = await UserManager.UpdateAsync(user);
        if (!updated.Succeeded)
        {
            _formError = string.Join("; ", updated.Errors.Select(e => e.Description));
            return;
        }

        var currentRole = await GetRole(user);
        if (currentRole != _model.Role)
        {
            foreach (var r in AppRoles.All)
            {
                if (await UserManager.IsInRoleAsync(user, r))
                {
                    await UserManager.RemoveFromRoleAsync(user, r);
                }
            }

            await UserManager.AddToRoleAsync(user, _model.Role);
        }

        // Обновляем stamp — активные сессии пользователя перечитают права.
        await UserManager.UpdateSecurityStampAsync(user);
        await WriteAuditAsync($"Изменён пользователь «{user.UserName}»");

        Toasts.Show("Изменения сохранены", ToastKind.Success);
        CloseForm();
        await LoadAsync();
    }

    // -------------------------------------------------- права на колонки

    private sealed class ColumnPermRow
    {
        public string Key { get; set; } = string.Empty;
        public string Title { get; set; } = string.Empty;
        public bool View { get; set; }
        public bool Edit { get; set; }
    }

    private bool _showColumns;
    private UserRow? _columnsUser;
    private ColumnAccessMode _columnMode = ColumnAccessMode.AllColumns;
    private List<ColumnPermRow> _columnRows = new();
    private string? _columnError;

    private async Task TestNotifyAsync(UserRow user)
    {
        if (string.IsNullOrWhiteSpace(user.BitrixUserId))
        {
            Toasts.Show("У пользователя не заполнен «ID сотрудника в Битрикс24»", ToastKind.Error);
            return;
        }

        var result = await Bitrix.SendTestAsync(user.BitrixUserId);
        Toasts.Show(
            result.Success
                ? $"Тестовое уведомление отправлено сотруднику Битрикс24 (ID {user.BitrixUserId})"
                : (result.Error ?? "Не удалось отправить уведомление"),
            result.Success ? ToastKind.Success : ToastKind.Error);
    }

    private async Task OpenColumns(UserRow user)
    {
        _columnsUser = user;
        _columnMode = await ColumnAccess.GetModeAsync(user.Id);

        var permissions = (await ColumnAccess.GetPermissionsAsync(user.Id))
            .ToDictionary(p => p.Key, StringComparer.OrdinalIgnoreCase);

        _columnRows = RegistryColumns.All.Select(c =>
        {
            permissions.TryGetValue(c.Key, out var permission);

            return new ColumnPermRow
            {
                Key = c.Key,
                Title = c.Title,
                View = permission is not null ? permission.CanView : true,
                Edit = permission is not null ? permission.CanEdit : true
            };
        }).ToList();

        _columnError = null;
        _showColumns = true;
    }

    private void CloseColumns()
    {
        _showColumns = false;
        _columnsUser = null;
        _columnError = null;
    }

    private async Task SaveColumnsAsync()
    {
        if (_columnsUser is null)
        {
            return;
        }

        _busy = true;
        _columnError = null;

        try
        {
            var permissions = _columnRows
                .Select(r => new ColumnPermission(r.Key, r.View, r.View && r.Edit))
                .ToList();

            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            var result = await ColumnAccess.SetAsync(_columnsUser.Id, _columnMode, permissions, state.User.ToActor());

            if (result.Success)
            {
                Toasts.Show("Права на колонки сохранены", ToastKind.Success);
                CloseColumns();
            }
            else
            {
                _columnError = result.Error;
            }
        }
        catch (Exception ex)
        {
            _columnError = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private void AskDelete(UserRow user)
    {
        _confirm = new ConfirmRequest(
            "Удаление пользователя",
            $"Удалить учётную запись «{user.UserName}»?",
            "Удалить",
            async () =>
            {
                _confirm = null;
                await DeleteAsync(user);
            });
    }

    private async Task DeleteAsync(UserRow row)
    {
        if (string.Equals(row.Id, _currentUserId, StringComparison.Ordinal))
        {
            Toasts.Show("Нельзя удалить собственную учётную запись", ToastKind.Warning);
            return;
        }

        var user = await UserManager.FindByIdAsync(row.Id);
        if (user is null)
        {
            return;
        }

        var admins = await UserManager.GetUsersInRoleAsync(AppRoles.Admin);
        if (row.IsAdmin && admins.Count <= 1)
        {
            Toasts.Show("Это последний администратор — сначала назначьте права другому пользователю", ToastKind.Warning);
            return;
        }

        var deleted = await UserManager.DeleteAsync(user);
        if (deleted.Succeeded)
        {
            await WriteAuditAsync($"Удалён пользователь «{user.UserName}»");
            Toasts.Show("Пользователь удалён", ToastKind.Success);
            await LoadAsync();
        }
        else
        {
            Toasts.Show(string.Join("; ", deleted.Errors.Select(e => e.Description)), ToastKind.Error);
        }
    }

    private async Task WriteAuditAsync(string summary)
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var actor = state.User.ToActor();

        await Audit.WriteAsync(AuditAction.UserChanged, "User", 0, actor, summary: summary);
        await Notifier.PublishAsync(new RegistryChangeEvent(
            ChangeKind.UserChanged, "User", 0, actor.UserName, DateTime.UtcNow, summary));
    }

    public void Dispose()
    {
        EventBus.PresenceChanged -= OnPresenceChanged;
    }

    private sealed record ConfirmRequest(string Title, string Message, string ConfirmText, Func<Task> OnConfirm);
}
