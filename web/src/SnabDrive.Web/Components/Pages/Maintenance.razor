@page "/maintenance"
@using System.Security.Claims
@using SnabDrive.Web.Domain
@using SnabDrive.Web.Services
@inject IMaintenanceService MaintenanceSvc
@inject IToastService Toasts
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = AppRoles.Admin)]

<PageTitle>Очистка данных</PageTitle>
<PageHeader Icon="🗑"
            Title="Очистка данных"
            Subtitle="Полное удаление выбранного набора записей из базы данных. Используется для подготовки стенда и тестовых прогонов." />

<div class="alert alert--warn">
    <span>⚠ <strong>Действие необратимо.</strong> Записи удаляются из базы без возможности восстановления. Пользователи, роли и их права не затрагиваются.</span>
</div>

@if (_message is not null)
{
    <div class="alert alert-ok">
        <span>✔ @_message</span>
        <button type="button" class="alert__close" @onclick="() => _message = null" title="Скрыть">✕</button>
    </div>
}

<div class="section-card danger-zone">
    <h2>Что можно очистить</h2>
    <p class="section-card__hint">Каждый пункт затрагивает только свой набор данных. Перед очисткой рабочего контура сделайте резервную копию базы.</p>

    <div class="clean-grid">
        @foreach (var item in Datasets)
        {
            <div class="clean-item">
                <div class="clean-item__text">
                    <div class="clean-item__title"><span class="clean-item__icon">@item.Icon</span>@item.Title</div>
                    <div class="clean-item__hint">@item.Hint</div>
                </div>
                <button class="btn btn--danger btn--small" disabled="@_busy"
                        @onclick="() => Clear(item.Key, item.Title)">Очистить</button>
            </div>
        }
    </div>
</div>

@code {
    private bool _busy;
    private string? _message;

    /// <summary>Что можно очистить: ключ для сервиса, название и пояснение для интерфейса.</summary>
    private static readonly (string Key, string Title, string Hint, string Icon)[] Datasets =
    {
        ("registry", "Реестр", "Все закупки, цвета ячеек и журнал передач по ним", "▤"),
        ("archive", "Архив", "Архивированные закупки", "🗄"),
        ("kontur", "Контур — избранное", "Выгрузки избранного, ожидающие разбора", "★"),
        ("templates", "Контур — ловушка", "Сохранённые выгрузки ловушки", "🎯"),
        ("attachments", "Вложения", "Файлы, прикреплённые к закупкам", "📎"),
        ("notifications", "Уведомления о торгах", "Отправленные напоминания о предстоящих торгах", "🔔"),
        ("dictionaries", "Справочники", "Типы закупок, статусы B2B и статусы исполнения", "☰"),
        ("audit", "Журнал", "История изменений и статистика активности", "🕓"),
    };

    private async Task Clear(string dataset, string label)
    {
        var ok = await JS.InvokeAsync<bool>("confirm",
            $"ВНИМАНИЕ: все записи «{label}» будут безвозвратно удалены из базы данных. Продолжить?");
        if (!ok) return;

        _busy = true;
        _message = null;
        try
        {
            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = state.User;
            var actor = new ChangeActor(user.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty,
                                        user.Identity?.Name ?? "admin");
            var result = await MaintenanceSvc.ClearAsync(dataset, actor);
            _message = result.Success
                ? $"«{label}» очищено. Удалено записей: {result.Value}."
                : $"Ошибка: {result.Error}";
            Toasts.Show(_message, result.Success ? ToastKind.Success : ToastKind.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
