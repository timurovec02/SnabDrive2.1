@page "/change-password"
@attribute [Authorize]
@inject NavigationManager Navigation
@inject SnabDrive.Web.Services.IPasswordPolicyService Policy

<PageTitle>Смена пароля — Снабдрайв</PageTitle>

<div class="page">
    <div class="page__header">
        <div>
            <h1>@(_first ? "Смена временного пароля" : "Смена пароля")</h1>
            <p class="page__hint">
                @(_first
                    ? "Администратор создал вашу учётную запись с временным паролем. Придумайте постоянный пароль — без этого работа в системе недоступна."
                    : "Задайте новый пароль учётной записи.")
            </p>
        </div>
    </div>

    <div class="section-card" style="max-width:520px">
        <form method="post" action="/account/change-password">
            <AntiforgeryToken />
            <input type="hidden" name="first" value="@(_first ? "1" : "0")" />

            @if (!string.IsNullOrEmpty(_errorText))
            {
                <div class="form-error">@_errorText</div>
            }

            @if (!string.IsNullOrEmpty(_noticeText))
            {
                <div class="form-notice">@_noticeText</div>
            }

            <div class="form-field">
                <label>@(_first ? "Временный пароль *" : "Текущий пароль *")</label>
                <div class="pw-wrap" style="position:relative">
                    <input class="input" type="password" name="currentPassword" autocomplete="current-password" required />
                    <button type="button" class="pw-eye" tabindex="-1" title="Показать пароль"
                                style="position:absolute;right:8px;top:50%%;transform:translateY(-50%%);border:0;background:transparent;cursor:pointer;padding:6px;color:#64748b;display:inline-flex"
                                onclick="var i=this.parentNode.querySelector('input');var s=i.type==='password';i.type=s?'text':'password';this.title=s?'Скрыть пароль':'Показать пароль';this.querySelector('.pw-eye__on').hidden=!s;this.querySelector('.pw-eye__off').hidden=s;">
                            <span class="pw-eye__on"><Icon Name="eye" /></span>
                            <span class="pw-eye__off" hidden><Icon Name="eyeOff" /></span>
                        </button>
                </div>
            </div>

            <div class="form-field">
                <label>Новый пароль *</label>
                <div class="pw-wrap" style="position:relative">
                    <input class="input" type="password" name="newPassword" autocomplete="new-password" required />
                    <button type="button" class="pw-eye" tabindex="-1" title="Показать пароль"
                                style="position:absolute;right:8px;top:50%%;transform:translateY(-50%%);border:0;background:transparent;cursor:pointer;padding:6px;color:#64748b;display:inline-flex"
                                onclick="var i=this.parentNode.querySelector('input');var s=i.type==='password';i.type=s?'text':'password';this.title=s?'Скрыть пароль':'Показать пароль';this.querySelector('.pw-eye__on').hidden=!s;this.querySelector('.pw-eye__off').hidden=s;">
                            <span class="pw-eye__on"><Icon Name="eye" /></span>
                            <span class="pw-eye__off" hidden><Icon Name="eyeOff" /></span>
                        </button>
                </div>
                <div class="wf-hint">Требования: @_policyHint</div>
            </div>

            <div class="form-field">
                <label>Повторите новый пароль *</label>
                <div class="pw-wrap" style="position:relative">
                    <input class="input" type="password" name="confirmPassword" autocomplete="new-password" required />
                    <button type="button" class="pw-eye" tabindex="-1" title="Показать пароль"
                                style="position:absolute;right:8px;top:50%%;transform:translateY(-50%%);border:0;background:transparent;cursor:pointer;padding:6px;color:#64748b;display:inline-flex"
                                onclick="var i=this.parentNode.querySelector('input');var s=i.type==='password';i.type=s?'text':'password';this.title=s?'Скрыть пароль':'Показать пароль';this.querySelector('.pw-eye__on').hidden=!s;this.querySelector('.pw-eye__off').hidden=s;">
                            <span class="pw-eye__on"><Icon Name="eye" /></span>
                            <span class="pw-eye__off" hidden><Icon Name="eyeOff" /></span>
                        </button>
                </div>
            </div>

            <button type="submit" class="btn btn--primary">Сменить пароль</button>
        </form>
    </div>
</div>

@code {

    private bool _first;
    private string? _errorText;
    private string? _noticeText;
    private string _policyHint = "не менее 10 символов, заглавная и строчная буквы, цифра, спецсимвол";

    protected override async Task OnInitializedAsync()
    {
        var uri = new Uri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);

        _first = query.ContainsKey("first");

        if (query.ContainsKey("changed"))
        {
            _noticeText = "Пароль изменён.";
        }

        if (query.TryGetValue("error", out var error))
        {
            _errorText = error.ToString() switch
            {
                "empty" => "Заполните все поля.",
                "mismatch" => "Новые пароли не совпадают.",
                "invalid" => "Текущий пароль неверен.",
                "policy" => query.TryGetValue("msg", out var msg) && msg.Count > 0
                    ? msg.ToString()
                    : "Новый пароль не подходит под политику паролей.",
                "token" => "Сессия устарела. Попробуйте ещё раз.",
                _ => "Не удалось сменить пароль."
            };
        }

        try
        {
            var policy = await Policy.GetAsync();
            _policyHint = Policy.Describe(policy);
        }
        catch
        {
            // Пререндер (F5) может не иметь контекста — цепь повторит инициализацию.
        }
    }
}
