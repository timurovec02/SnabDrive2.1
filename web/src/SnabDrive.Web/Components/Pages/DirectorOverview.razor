@page "/director"
@using System.Linq
@using System.Security.Claims
@using SnabDrive.Web.Data
@using SnabDrive.Web.Domain
@using SnabDrive.Web.Services
@attribute [Authorize(Policy = AppPolicies.ManageSystem)]
@implements IDisposable
@inject IRegistryService Registry
@inject IKonturService Kontur
@inject IPresenceService Presence
@inject IRegistryEventBus EventBus

<PageHeader Icon="📊"
            Title="Обзор директора"
            Subtitle="Сводная аналитика по закупкам, активности сотрудников и выгрузкам «Контур ловушка»." />

@if (_error is not null)
{
    <div class="alert alert-error">@_error</div>
}

<div class="stat-grid">
    <div class="stat-tile">
        <div class="stat-tile__label">Записей в реестре</div>
        <div class="stat-tile__value">@_registryCount</div>
        <div class="stat-tile__hint">активные закупки</div>
    </div>
    <div class="stat-tile stat-tile--ok">
        <div class="stat-tile__label">Записей в архиве</div>
        <div class="stat-tile__value">@_archiveCount</div>
        <div class="stat-tile__hint">завершённые и закрытые</div>
    </div>
    <div class="stat-tile stat-tile--warn">
        <div class="stat-tile__label">Сейчас онлайн</div>
        <div class="stat-tile__value">@_online.Count</div>
        <div class="stat-tile__hint">
            @if (_online.Count > 0)
            {
                @string.Join(", ", _online.Select(u => u.UserName))
            }
            else
            {
                <span>кроме вас никого нет</span>
            }
        </div>
    </div>
    <div class="stat-tile">
        <div class="stat-tile__label">Время сервера</div>
        <div class="stat-tile__value">@_serverTime.ToString("HH:mm")</div>
        <div class="stat-tile__hint">данные обновляются автоматически</div>
    </div>
</div>

<div class="toolbar" style="flex-wrap:wrap;gap:8px;margin:12px 0">
    <label class="muted">Период (дата торгов):</label>
    <input type="date" class="input" style="width:170px" @bind="_from" @bind:after="Recompute" />
    <span class="muted">—</span>
    <input type="date" class="input" style="width:170px" @bind="_to" @bind:after="Recompute" />
    <button class="btn btn-sm" @onclick='() => SetPeriod("month")'>Этот месяц</button>
    <button class="btn btn-sm" @onclick='() => SetPeriod("prev")'>Прошлый месяц</button>
    <button class="btn btn-sm" @onclick='() => SetPeriod("quarter")'>Квартал</button>
    <button class="btn btn-sm" @onclick='() => SetPeriod("year")'>Год</button>
    <button class="btn btn-sm" @onclick='() => SetPeriod("all")'>Всё</button>
</div>

@if (_loading)
{
    <p class="muted">Загрузка…</p>
}
else
{
    <div class="stat-grid">
        <div class="stat-tile">
            <div class="stat-tile__label">Всего закупок</div>
            <div class="stat-tile__value">@_total</div>
            <div class="stat-tile__hint">за выбранный период</div>
        </div>
        <div class="stat-tile">
            <div class="stat-tile__label">Сумма НМЦК</div>
            <div class="stat-tile__value">@_sumNmc.ToString("N0")</div>
        </div>
        <div class="stat-tile stat-tile--ok">
            <div class="stat-tile__label">Сумма итоговых цен</div>
            <div class="stat-tile__value">@_sumResult.ToString("N0")</div>
        </div>
        <div class="stat-tile stat-tile--warn">
            <div class="stat-tile__label">Ловушка: записей</div>
            <div class="stat-tile__value">@_templatesTotal</div>
        </div>
        <div class="stat-tile stat-tile--warn">
            <div class="stat-tile__label">Ловушка: «Интересно»</div>
            <div class="stat-tile__value">@_templatesInteresting</div>
            <div class="stat-tile__hint">отмечено меткой</div>
        </div>
    </div>

    <h2 class="section-title" style="margin:22px 0 10px">По месяцам (дата торгов)</h2>
    <table class="data-table">
        <thead><tr><th>Месяц</th><th>Кол-во</th><th>Сумма НМЦК</th></tr></thead>
        <tbody>
            @if (!_byMonth.Any())
            {
                <tr><td colspan="3" class="muted">Нет данных за период.</td></tr>
            }
            @foreach (var m in _byMonth)
            {
                <tr><td>@m.Key</td><td>@m.Count</td><td>@m.Sum.ToString("N0")</td></tr>
            }
        </tbody>
    </table>

    <h2 class="section-title" style="margin:22px 0 10px">Топ заказчиков</h2>
    <table class="data-table">
        <thead><tr><th>Заказчик</th><th>Кол-во</th><th>Сумма НМЦК</th></tr></thead>
        <tbody>
            @if (!_topCustomers.Any())
            {
                <tr><td colspan="3" class="muted">Нет данных за период.</td></tr>
            }
            @foreach (var c in _topCustomers)
            {
                <tr><td>@c.Name</td><td>@c.Count</td><td>@c.Sum.ToString("N0")</td></tr>
            }
        </tbody>
    </table>
}

@code {
    private bool _loading = true;
    private string? _error;

    private int _registryCount;
    private int _archiveCount;
    private IReadOnlyList<OnlineUser> _online = Array.Empty<OnlineUser>();
    private DateTime _serverTime = DateTime.Now;

    private List<RegistryRowDto> _all = new();
    private List<SnabDrive.Web.Data.Entities.KonturTemplate> _templates = new();

    private DateTime? _from;
    private DateTime? _to;

    private int _total;
    private decimal _sumNmc;
    private decimal _sumResult;
    private int _templatesTotal;
    private int _templatesInteresting;

    private List<(string Key, int Count, decimal Sum)> _byMonth = new();
    private List<(string Name, int Count, decimal Sum)> _topCustomers = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            EventBus.Changed += OnChanged;
            EventBus.PresenceChanged += OnPresenceChanged;
            await LoadCountsAsync();

            _all = new List<RegistryRowDto>();
            var page = 1;
            while (page <= 200)
            {
                var res = await Registry.QueryAsync(new RegistryQuery { Page = page, PageSize = RegistryQuery.MaxPageSize });
                _all.AddRange(res.Items);
                if (res.Items.Count == 0 || _all.Count >= res.TotalCount)
                {
                    break;
                }
                page++;
            }

            _templates = (await Kontur.GetTemplatesAsync()).ToList();
            _templatesTotal = _templates.Count;
            _templatesInteresting = _templates.Count(t =>
                !string.IsNullOrWhiteSpace(t.Label) &&
                t.Label.Contains("интересно", StringComparison.OrdinalIgnoreCase));

            Recompute();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadCountsAsync()
    {
        _registryCount = await Registry.CountAsync();
        _archiveCount = await Registry.CountArchiveAsync();
        _online = Presence.GetOnline();
        _serverTime = DateTime.Now;
    }

    private void OnChanged(RegistryChangeEvent changeEvent) => _ = InvokeAsync(async () =>
    {
        await LoadCountsAsync();
        StateHasChanged();
    });

    private void OnPresenceChanged(IReadOnlyList<OnlineUser> online)
    {
        _online = online;
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        EventBus.Changed -= OnChanged;
        EventBus.PresenceChanged -= OnPresenceChanged;
    }

    private void Recompute()
    {
        var rows = _all.AsEnumerable();
        if (_from is not null)
        {
            var f = _from.Value.Date;
            rows = rows.Where(r => r.BiddingDate is not null && r.BiddingDate.Value.Date >= f);
        }
        if (_to is not null)
        {
            var t = _to.Value.Date;
            rows = rows.Where(r => r.BiddingDate is not null && r.BiddingDate.Value.Date <= t);
        }

        var list = rows.ToList();
        _total = list.Count;
        _sumNmc = list.Sum(r => r.NMCK);
        _sumResult = list.Sum(r => r.ResultPrice);

        _byMonth = list
            .Where(r => r.BiddingDate is not null)
            .GroupBy(r => r.BiddingDate!.Value.ToString("yyyy-MM"))
            .Select(g => (Key: g.Key, Count: g.Count(), Sum: g.Sum(x => x.NMCK)))
            .OrderByDescending(x => x.Key)
            .ToList();

        _topCustomers = list
            .Where(r => !string.IsNullOrWhiteSpace(r.Customer))
            .GroupBy(r => r.Customer)
            .Select(g => (Name: g.Key, Count: g.Count(), Sum: g.Sum(x => x.NMCK)))
            .OrderByDescending(x => x.Count)
            .ThenByDescending(x => x.Sum)
            .Take(10)
            .ToList();
    }

    private void SetPeriod(string kind)
    {
        var today = DateTime.Today;
        switch (kind)
        {
            case "month":
                _from = new DateTime(today.Year, today.Month, 1);
                _to = _from.Value.AddMonths(1).AddDays(-1);
                break;
            case "prev":
                _from = new DateTime(today.Year, today.Month, 1).AddMonths(-1);
                _to = new DateTime(today.Year, today.Month, 1).AddDays(-1);
                break;
            case "quarter":
                var q = (today.Month - 1) / 3;
                _from = new DateTime(today.Year, q * 3 + 1, 1);
                _to = _from.Value.AddMonths(3).AddDays(-1);
                break;
            case "year":
                _from = new DateTime(today.Year, 1, 1);
                _to = new DateTime(today.Year, 12, 31);
                break;
            default:
                _from = null;
                _to = null;
                break;
        }
        Recompute();
    }
}
