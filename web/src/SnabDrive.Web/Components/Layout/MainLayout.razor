@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject AuthenticationStateProvider AuthStateProvider
@inject SnabDrive.Web.Services.IRolePermissionService RolePerms
@inject IPresenceService Presence
@inject UserSessionState Session
@inject IToastService Toasts
@inject SnabDrive.Web.Services.KonturSchedulerState SchedulerState
@inject NavigationManager Navigation
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

<div class="app-shell @(_navCollapsed ? "nav-collapsed" : "")">
    @if (_exportRunning)
    {
        <div class="export-lock" style="position:fixed;inset:0;background:rgba(15,23,42,.55);z-index:3000;display:flex;align-items:center;justify-content:center">
            <div style="background:#fff;padding:28px 36px;border-radius:10px;text-align:center;max-width:440px;box-shadow:0 10px 40px rgba(0,0,0,.3)">
                <div class="boot-spin"><Icon Name="refresh" Class="boot-spin__icon" /></div>
                <h3 style="margin:.4rem 0">Идёт выгрузка Контура…</h3>
                <p class="muted" style="margin:0">Действия на сайте временно заблокированы до завершения выгрузки.</p>
            </div>
        </div>
    }
    <header class="app-header">
        <button class="btn btn--ghost nav-toggle" @onclick="ToggleNav" title="@(_navCollapsed ? "Развернуть меню" : "Свернуть меню")"><Icon Name="@(_navCollapsed ? "chevronRight" : "chevronLeft")" /></button>
        <div class="app-header__brand">
            <img class="app-logo" src="favicon.png?v=4" alt="" width="32" height="32" />
            <div>
                <div class="app-title">Снабдрайв</div>
                <div class="app-subtitle">Реестр закупок</div>
            </div>
        </div>

        <div class="app-header__spacer"></div>

        <TableTextSizer />

        <PresenceWidget />

        <div class="app-header__user">
            <span class="user-name" title="@_email">@_displayName</span>
            @if (_isAdmin)
            {
                <span class="badge badge--admin">Админ</span>
            }
            <a class="btn btn--ghost" href="change-password" title="Сменить пароль">Сменить пароль</a>
        </div>

        <form method="post" action="/account/logout" class="logout-form">
            <AntiforgeryToken />
            <button type="submit" class="btn btn--ghost" title="Выйти из системы">Выйти</button>
        </form>
    </header>

    <div class="app-body">
        <NavMenu Collapsed="_navCollapsed" Features="_features" />

        <main class="app-main">
            @* Центральная проверка доступа к вкладкам: скрытая в меню вкладка
               не должна открываться и прямой ссылкой. *@
            @if (_routeBlocked)
            {
                <div class="page" style="padding:32px 20px">
                    <div class="card" style="max-width:560px">
                        <h2 style="margin:0 0 8px;font-size:18px">Нет доступа к этой вкладке</h2>
                        <p class="muted" style="margin:0">Раздел «@_blockedTitle» выключен для вашей учётной записи. Обратитесь к администратору, чтобы включить вкладку в правах доступа.</p>
                    </div>
                </div>
            }
            else
            {
                @Body
            }
        </main>
    </div>
</div>

<ToastHost />

@code {
    private string _displayName = "…";
    private string _email = string.Empty;
    private bool _isAdmin;
    private bool _navCollapsed;
    private bool _konturEnabled;
    private bool _schedulerEnabled;
    private bool _isDirector;
    private Dictionary<string, bool> _features = new();
    private bool _exportRunning;
    private bool _schedulerHooked;
    private bool _routeBlocked;
    private string _blockedTitle = string.Empty;

    /// <summary>Маршрут → вкладка (ключ AppFeatures) → заголовок. Проверка идёт центрально,
    /// чтобы доступ к вкладке соблюдался и при прямом переходе по ссылке.</summary>
    private static readonly (string Path, string Feature, string Title)[] FeatureRoutes =
    {
        ("/", SnabDrive.Web.Services.AppFeatures.Registry, "Реестр"),
        ("/registry", SnabDrive.Web.Services.AppFeatures.Registry, "Реестр"),
        ("/archive", SnabDrive.Web.Services.AppFeatures.Archive, "Архив"),
        ("/workflow", SnabDrive.Web.Services.AppFeatures.Workflow, "Задачи"),
        ("/kontur", SnabDrive.Web.Services.AppFeatures.Kontur, "Контур — избранное"),
        ("/kontur-templates", SnabDrive.Web.Services.AppFeatures.Kontur, "Контур — шаблоны"),
        ("/kontur-scheduler", SnabDrive.Web.Services.AppFeatures.Scheduler, "Планировщик Контура"),
        ("/director", SnabDrive.Web.Services.AppFeatures.Director, "Ловушка / Директор"),
        ("/dictionaries", SnabDrive.Web.Services.AppFeatures.Dictionaries, "Справочники"),
        ("/audit", SnabDrive.Web.Services.AppFeatures.Audit, "Журнал аудита"),
        ("/stats", SnabDrive.Web.Services.AppFeatures.Audit, "Статистика"),
        ("/users", SnabDrive.Web.Services.AppFeatures.Users, "Пользователи"),
        ("/roles", SnabDrive.Web.Services.AppFeatures.Users, "Роли"),
        ("/import-registry", SnabDrive.Web.Services.AppFeatures.Users, "Импорт реестра"),
        ("/maintenance", SnabDrive.Web.Services.AppFeatures.Users, "Очистка данных"),
    };

    /// <summary>Считает, заблокирован ли текущий маршрут для пользователя.</summary>
    private void RefreshRouteGate()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri);
        var cut = path.IndexOfAny(new[] { '?', '#' });
        if (cut >= 0)
        {
            path = path[..cut];
        }

        path = "/" + path.Trim('/').ToLowerInvariant();

        _routeBlocked = false;
        _blockedTitle = string.Empty;
        foreach (var (route, feature, title) in FeatureRoutes)
        {
            if (route == path && !(_features.TryGetValue(feature, out var ok) && ok))
            {
                _routeBlocked = true;
                _blockedTitle = title;
                return;
            }
        }
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        RefreshRouteGate();
        _ = InvokeAsync(StateHasChanged);
    }

    private void ToggleNav() => _navCollapsed = !_navCollapsed;

    protected override async Task OnParametersSetAsync()
    {
        // Первый вход: администратор создал учётку с временным паролем — пока пароль
        // не сменён, пользователь находится только на странице /change-password.
        // Во время пререндера (HttpContext есть) не перенаправляем: срабатывает
        // интерактивная фаза, когда циркул подключится.
        if (HttpContextAccessor.HttpContext is not null)
        {
            return;
        }

        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        if (SnabDrive.Web.Data.MustChangePasswordClaim.IsSet(state.User) &&
            !Navigation.Uri.Contains("/change-password", StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo("/change-password?first=1");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Toasts.Changed += OnToastsChanged;
        Navigation.LocationChanged += OnLocationChanged;

        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = state.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            _displayName = user.FindFirstValue("DisplayName") ?? user.Identity.Name ?? "пользователь";
            _email = user.FindFirstValue(ClaimTypes.Email) ?? string.Empty;
            _isAdmin = user.IsInRole(SnabDrive.Web.Services.AppRoles.Admin);
            _isDirector = user.IsInRole(SnabDrive.Web.Services.AppRoles.Director);
            _konturEnabled = SnabDrive.Web.Data.KonturClaim.CanUse(user);
            _schedulerEnabled = SnabDrive.Web.Data.SchedulerClaim.CanUse(user);
            _features = await RolePerms.GetEffectiveFeaturesAsync(user.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty);
        }

        RefreshRouteGate();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_schedulerHooked)
        {
            _schedulerHooked = true;
            _exportRunning = SchedulerState.IsRunning;
            SchedulerState.Changed += OnSchedulerChanged;
        }

        if (!firstRender || Session.PresenceRegistered)
        {
            return;
        }

        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = state.User.FindFirstValue(ClaimTypes.NameIdentifier);

        if (string.IsNullOrEmpty(userId))
        {
            return;
        }

        Session.PresenceRegistered = true;
        Presence.Register(Session.SessionId, SessionKind.Blazor, userId, _displayName);
    }

    private void OnToastsChanged() => InvokeAsync(StateHasChanged);

    private void OnSchedulerChanged()
    {
        _exportRunning = SchedulerState.IsRunning;
        _ = InvokeAsync(StateHasChanged);
    }

    public ValueTask DisposeAsync()
    {
        if (_schedulerHooked)
        {
            SchedulerState.Changed -= OnSchedulerChanged;
            _schedulerHooked = false;
        }
        Toasts.Changed -= OnToastsChanged;
        Navigation.LocationChanged -= OnLocationChanged;

        if (Session.PresenceRegistered)
        {
            Presence.Unregister(Session.SessionId);
            Session.PresenceRegistered = false;
        }

        return ValueTask.CompletedTask;
    }
}
