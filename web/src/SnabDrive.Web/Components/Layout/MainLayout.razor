@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject AuthenticationStateProvider AuthStateProvider
@inject SnabDrive.Web.Services.IRolePermissionService RolePerms
@inject IPresenceService Presence
@inject UserSessionState Session
@inject IToastService Toasts
@inject SnabDrive.Web.Services.KonturSchedulerState SchedulerState

<div class="app-shell @(_navCollapsed ? "nav-collapsed" : "")">
    @if (_exportRunning)
    {
        <div class="export-lock" style="position:fixed;inset:0;background:rgba(15,23,42,.55);z-index:3000;display:flex;align-items:center;justify-content:center">
            <div style="background:#fff;padding:28px 36px;border-radius:10px;text-align:center;max-width:440px;box-shadow:0 10px 40px rgba(0,0,0,.3)">
                <div style="font-size:34px">⏳</div>
                <h3 style="margin:.4rem 0">Идёт выгрузка Контура…</h3>
                <p class="muted" style="margin:0">Действия на сайте временно заблокированы до завершения выгрузки.</p>
            </div>
        </div>
    }
    <header class="app-header">
        <button class="btn btn--ghost nav-toggle" @onclick="ToggleNav" title="@(_navCollapsed ? "Развернуть меню" : "Свернуть меню")">@(_navCollapsed ? "»" : "«")</button>
        <div class="app-header__brand">
            <span class="app-logo">SD</span>
            <div>
                <div class="app-title">SnabDrive</div>
                <div class="app-subtitle">Реестр закупок</div>
            </div>
        </div>

        <div class="app-header__spacer"></div>

        <PresenceWidget />

        <div class="app-header__user">
            <span class="user-name" title="@_email">@_displayName</span>
            @if (_isAdmin)
            {
                <span class="badge badge--admin">Админ</span>
            }
        </div>

        <form method="post" action="/account/logout" class="logout-form">
            <AntiforgeryToken />
            <button type="submit" class="btn btn--ghost" title="Выйти из системы">Выйти</button>
        </form>
    </header>

    <div class="app-body">
        <NavMenu Collapsed="_navCollapsed" Features="_features" />

        <main class="app-main">
            @Body
        </main>
    </div>
</div>

<ToastHost />

@code {
    private string _displayName = "…";
    private string _email = string.Empty;
    private bool _isAdmin;
    private bool _navCollapsed;
    private bool _konturEnabled;
    private bool _schedulerEnabled;
    private bool _isDirector;
    private Dictionary<string, bool> _features = new();
    private bool _exportRunning;
    private bool _schedulerHooked;

    private void ToggleNav() => _navCollapsed = !_navCollapsed;

    protected override async Task OnInitializedAsync()
    {
        Toasts.Changed += OnToastsChanged;

        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = state.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            _displayName = user.FindFirstValue("DisplayName") ?? user.Identity.Name ?? "пользователь";
            _email = user.FindFirstValue(ClaimTypes.Email) ?? string.Empty;
            _isAdmin = user.IsInRole(SnabDrive.Web.Services.AppRoles.Admin);
            _isDirector = user.IsInRole(SnabDrive.Web.Services.AppRoles.Director);
            _konturEnabled = SnabDrive.Web.Data.KonturClaim.CanUse(user);
            _schedulerEnabled = SnabDrive.Web.Data.SchedulerClaim.CanUse(user);
            _features = await RolePerms.GetEffectiveFeaturesAsync(user.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_schedulerHooked)
        {
            _schedulerHooked = true;
            _exportRunning = SchedulerState.IsRunning;
            SchedulerState.Changed += OnSchedulerChanged;
        }

        if (!firstRender || Session.PresenceRegistered)
        {
            return;
        }

        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = state.User.FindFirstValue(ClaimTypes.NameIdentifier);

        if (string.IsNullOrEmpty(userId))
        {
            return;
        }

        Session.PresenceRegistered = true;
        Presence.Register(Session.SessionId, SessionKind.Blazor, userId, _displayName);
    }

    private void OnToastsChanged() => InvokeAsync(StateHasChanged);

    private void OnSchedulerChanged()
    {
        _exportRunning = SchedulerState.IsRunning;
        _ = InvokeAsync(StateHasChanged);
    }

    public ValueTask DisposeAsync()
    {
        if (_schedulerHooked)
        {
            SchedulerState.Changed -= OnSchedulerChanged;
            _schedulerHooked = false;
        }
        Toasts.Changed -= OnToastsChanged;

        if (Session.PresenceRegistered)
        {
            Presence.Unregister(Session.SessionId);
            Session.PresenceRegistered = false;
        }

        return ValueTask.CompletedTask;
    }
}
