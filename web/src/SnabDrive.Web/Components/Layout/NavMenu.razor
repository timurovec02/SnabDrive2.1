@using SnabDrive.Web.Services
@inject NavigationManager Navigation

<nav class="nav" title="@(Collapsed ? "Меню свёрнуто" : null)">
    @if (Feat(AppFeatures.Registry))
    {
        <NavLink class="nav__item" href="" Match="NavLinkMatch.All" title="Реестр">
            <Icon Name="registry" Class="nav__icon" /><span class="nav__label">Реестр</span>
        </NavLink>
    }

    @if (Feat(AppFeatures.Workflow))
    {
        <NavLink class="nav__item" href="workflow" title="Задачи">
            <Icon Name="workflow" Class="nav__icon" /><span class="nav__label">Задачи</span>
        </NavLink>
    }

    @if (Feat(AppFeatures.Archive))
    {
        <NavLink class="nav__item" href="archive" title="Архив">
            <Icon Name="archive" Class="nav__icon" /><span class="nav__label">Архив</span>
        </NavLink>
    }

    @if (Feat(AppFeatures.Kontur))
    {
        <NavLink class="nav__item" href="kontur" title="Контур избранное">
            <Icon Name="favorites" Class="nav__icon" /><span class="nav__label">Контур избранное</span>
        </NavLink>
        <NavLink class="nav__item" href="kontur-templates" title="Контур шаблоны">
            <Icon Name="templates" Class="nav__icon" /><span class="nav__label">Контур шаблоны</span>
        </NavLink>
    }

    @if (Feat(AppFeatures.Scheduler))
    {
        <NavLink class="nav__item" href="kontur-scheduler" title="Планировщик Контур">
            <Icon Name="scheduler" Class="nav__icon" /><span class="nav__label">Планировщик</span>
        </NavLink>
    }

    @if (Feat(AppFeatures.Director))
    {
        <NavLink class="nav__item" href="director" title="Обзор директора">
            <Icon Name="director" Class="nav__icon" /><span class="nav__label">Обзор директора</span>
        </NavLink>
    }

    @if (Feat(AppFeatures.Dictionaries) || Feat(AppFeatures.Users) || Feat(AppFeatures.Audit))
    {
        <div class="nav__divider"></div>
        <div class="nav__group-title" title="Раздел администратора">Администрирование</div>
    }

    @if (Feat(AppFeatures.Dictionaries))
    {
        <NavLink class="nav__item" href="dictionaries" title="Справочники">
            <Icon Name="dictionaries" Class="nav__icon" /><span class="nav__label">Справочники</span>
        </NavLink>
    }
    @if (Feat(AppFeatures.Users))
    {
        <NavLink class="nav__item" href="users" title="Пользователи">
            <Icon Name="users" Class="nav__icon" /><span class="nav__label">Пользователи</span>
        </NavLink>
        <NavLink class="nav__item" href="roles" title="Настройка ролей">
            <Icon Name="roles" Class="nav__icon" /><span class="nav__label">Роли</span>
        </NavLink>
        <NavLink class="nav__item" href="maintenance" title="Очистка данных">
            <Icon Name="maintenance" Class="nav__icon" /><span class="nav__label">Очистка данных</span>
        </NavLink>
        <NavLink class="nav__item" href="import-registry" title="Импорт реестра">
            <Icon Name="import" Class="nav__icon" /><span class="nav__label">Импорт реестра</span>
        </NavLink>
    }
    @if (Feat(AppFeatures.Audit))
    {
        <NavLink class="nav__item" href="audit" title="Журнал">
            <Icon Name="audit" Class="nav__icon" /><span class="nav__label">Журнал</span>
        </NavLink>
        <NavLink class="nav__item" href="stats" title="Статистика активности">
            <Icon Name="stats" Class="nav__icon" /><span class="nav__label">Статистика</span>
        </NavLink>
    }
</nav>

@code {
    [Parameter] public bool Collapsed { get; set; }

    /// <summary>Доступ к вкладкам (ключ AppFeatures → разрешено) — из прав роли пользователя.</summary>
    [Parameter] public Dictionary<string, bool> Features { get; set; } = new();

    private bool Feat(string key) => Features.TryGetValue(key, out var v) && v;
}
