@using Microsoft.AspNetCore.Components.Web
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
<!DOCTYPE html>
<html lang="ru">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="@BaseHref" />
    <link rel="stylesheet" href="css/app.css" />
    <title>SnabDrive — реестр закупок</title>
    <HeadOutlet />
</head>

<body>
    @* Весь UI работает в интерактивном серверном режиме: один циркул на пользователя,
       realtime-обновление таблицы идёт по этому же соединению.
       prerender: false — рабочие страницы НЕ пререндерятся на сервере. Иначе при F5
       OnInitializedAsync выполняется в контексте пререндера (без цепи), где вызовы
       AuthenticationStateProvider/данные падают и страница показывает ошибку загрузки.
       Пререндер оставлен только для страницы входа (см. Login.razor). *@
    <Routes @rendermode="new InteractiveServerRenderMode(prerender: false)" />
    <script src="_framework/blazor.web.js"></script>
    <script src="js/realtime.js"></script>
</body>

</html>

@code {
    // Базовый путь приложения: "/" при размещении в корне сайта и "/snabdrive/" при
    // размещении в под-приложении IIS. Без этого blazor.web.js, css и SignalR в подпапке
    // запрашивались бы от корня и отдавали 404 (страница входа есть, а интерактив нет).
    private string BaseHref
    {
        get
        {
            var pathBase = HttpContextAccessor.HttpContext?.Request.PathBase.Value;
            if (string.IsNullOrEmpty(pathBase))
            {
                return "/";
            }

            return pathBase.EndsWith("/") ? pathBase : pathBase + "/";
        }
    }
}
