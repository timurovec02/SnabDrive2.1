@using Microsoft.AspNetCore.Components.Web
<!DOCTYPE html>
<html lang="ru">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="css/app.css" />
    <title>SnabDrive — реестр закупок</title>
    <HeadOutlet />
</head>

<body>
    @* Весь UI работает в интерактивном серверном режиме: один циркул на пользователя,
       realtime-обновление таблицы идёт по этому же соединению.
       prerender: true — страница логина и оболочка отдаются готовым HTML с сервера,
       поэтому вход работает даже до загрузки blazor.web.js (иначе белая страница). *@
    <Routes @rendermode="new InteractiveServerRenderMode(prerender: true)" />
    <script src="_framework/blazor.web.js"></script>
    <script src="js/realtime.js"></script>
</body>

</html>
