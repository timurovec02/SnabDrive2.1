@* Единая шапка вкладки: иконка, заголовок, подсказка и действия справа.
   Используется всеми страницами, кроме «Реестра» (там своя панель инструментов). *@

<div class="page-hero">
    <div class="page-hero__main">
        @if (!string.IsNullOrWhiteSpace(Icon))
        {
            <span class="page-hero__icon" aria-hidden="true">@Icon</span>
        }
        <div>
            <h1 class="page-hero__title">@Title</h1>
            @if (!string.IsNullOrWhiteSpace(Subtitle))
            {
                <p class="page-hero__subtitle">@Subtitle</p>
            }
        </div>
    </div>

    @if (Actions is not null)
    {
        <div class="page-hero__actions">@Actions</div>
    }
</div>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;

    [Parameter] public string? Subtitle { get; set; }

    [Parameter] public string? Icon { get; set; }

    /// <summary>Кнопки и фильтры, которые стоят справа от заголовка.</summary>
    [Parameter] public RenderFragment? Actions { get; set; }
}
