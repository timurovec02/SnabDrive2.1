<?xml version="1.0" encoding="utf-8"?>
<!--
  Настройки размещения в IIS. Файл публикуется вместе с приложением; при публикации
  .NET SDK сам подставляет processPath и arguments, менять их вручную не нужно.

  Заголовки безопасности (CSP, X-Content-Type-Options и др.) здесь намеренно НЕ заданы:
  их добавляет SecurityHeadersMiddleware в Program.cs — так не бывает двух разных
  значений одного заголовка в ответе. Здесь закрыто только то, что умеет один IIS.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>

      <aspNetCore processPath="dotnet" arguments=".\SnabDrive.Web.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <!-- Продакшн: страницы ошибок без подробностей, Swagger выключен,
               необработанные исключения не показываются пользователю. -->
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
          <!-- Подробные ошибки среды — всегда выключены, даже если кто-то поменяет окружение. -->
          <environmentVariable name="ASPNETCORE_DETAILEDERRORS" value="false" />
          <!-- Порт https для перенаправления http -> https: под IIS in-process приложение
               не всегда определяет его само. Совпадает с Security:HttpsPort. -->
          <environmentVariable name="ASPNETCORE_HTTPS_PORT" value="443" />
        </environmentVariables>
      </aspNetCore>

      <security>
        <!-- Не сообщаем версию платформы и не пускаем служебные методы. -->
        <requestFiltering removeServerHeader="true">
          <!-- 20 МБ — совпадает с AttachmentLimits.MaxSizeMb и лимитом тела запроса в Program.cs. -->
          <requestLimits maxAllowedContentLength="20971520" />
          <verbs allowUnlisted="true">
            <add verb="TRACE" allowed="false" />
            <add verb="TRACK" allowed="false" />
          </verbs>
          <!-- Конфигурация и журнал не должны отдаваться по URL ни при каких настройках.
               web.config и bin здесь НЕ перечислены: они уже есть в hiddenSegments
               машинного applicationHost.config, а повторная запись того же сегмента —
               это ошибка 0x800700b7 «Cannot add duplicate collection entry» и сайт
               не стартует (500.19). Унаследованная настройка продолжает работать.
               Если нужен полный контроль над списком — добавьте <clear /> первой строкой
               и перечислите нужное, включая web.config и bin. -->
          <hiddenSegments>
            <add segment="appsettings.json" />
            <add segment="appsettings.Production.json" />
            <add segment="appsettings.Development.json" />
            <add segment="logs" />
          </hiddenSegments>
        </requestFiltering>
      </security>

      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>

      <directoryBrowse enabled="false" />
    </system.webServer>
  </location>
</configuration>
