{
  "//": "Шаблон боевого подключения к snabdrive_db. Скопируйте этот файл в appsettings.Production.json и заполните значения. appsettings.Production.json в git НЕ коммитится (там пароль).",
  "//1": "Альтернатива файлу — переменная окружения ConnectionStrings__Registry на сервере.",
  "ConnectionStrings": {
    "Registry": "Server=ИМЯ_ИЛИ_IP_SQL,1433;Database=snabdrive_db;User Id=REPLACE_ME;Password=REPLACE_ME;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "Database": {
    "Provider": "SqlServer",
    "AutoMigrateIdentitySchema": false,
    "EnsureLegacySchema": false,
    "SeedRolesAndAdmin": true,
    "SeedAdminLogin": "admin",
    "SeedAdminPassword": "REPLACE_ME",
    "ImportLegacyUsers": false,
    "SeedDictionaries": true
  },
  "Bitrix": {
    "WebhookUrl": ""
  },
  "Kontur": {
    "ExporterPath": "C:\\KonturExport\\KonturExport.exe",
    "OutputDirectory": "C:\\KonturExport\\out",
    "TimeoutMinutes": 15,
    "TaskName": "SnabDriveKontur",
    "RequestFile": "C:\\KonturExport\\export-request.txt"
  },
  "DetailedErrors": false,
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
