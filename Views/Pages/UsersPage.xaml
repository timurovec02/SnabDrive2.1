<Page x:Class="SnabDrive2._0.Views.Pages.UsersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SnabDrive2._0.Views.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="UsersPage">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Row="0"
              Grid.ColumnSpan="2"
              Margin="5 5">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left">

                <Button x:Name="AddUser" 
                        Content="Добавить"
                        Click="AddUser_Click" 
                        Style="{DynamicResource btnAdd}"/>

                <Button x:Name="DeleteUser" 
                        Content="Удалить"
                        Click="DeleteUser_Click" 
                        Style="{DynamicResource btnDel}"/>

                <Button x:Name="UpdateUser" 
                        Content="Изменить"
                        Click="UpdateUser_Click" 
                        Style="{DynamicResource btnArch}"/>

            </StackPanel>

        </Grid>

        <DataGrid x:Name="UsersDGrid"
                  Grid.Column="0"
                  Grid.Row="1"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectedItem="{Binding selectedUser}">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Имя пользователя" 
                                    Binding="{Binding Login}"/>

                <DataGridTextColumn Header="Пароль"
                                    Binding="{Binding Password, UpdateSourceTrigger=PropertyChanged}"/>

                <DataGridTextColumn Header="Почта"
                                    Binding="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

                <DataGridTextColumn Header="Статус администратора"
                                    Binding="{Binding IsAdmin, UpdateSourceTrigger=PropertyChanged}"/>
            </DataGrid.Columns>

        </DataGrid>
        <Grid x:Name="UsersAdd"
              Grid.Row="1"
              Grid.Column="1"
              Visibility="Collapsed">
            <StackPanel>

                <TextBox x:Name="LoginTxb"/>

                <TextBox x:Name="PasswordTxb"/>

                <TextBox x:Name="EmailTxb"/>

                <CheckBox x:Name="IsAdminChB"/>

                <Button x:Name="SaveBtn"
                        Content="Сохранить"
                        Click="SaveBtn_Click"
                        />
                <Button x:Name="UpdateBtn"
                        Content="Подтвердить изменения"
                        Click="UpdateBtn_Click"
                        Visibility="Collapsed"/>
            </StackPanel>

        </Grid>
    </Grid>
</Page>
